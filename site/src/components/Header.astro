---
import { firma } from '../lib/firma';
import Wordmark from './Wordmark.astro';

interface Props {
  /** 'home' is the one-page nav with the script switch, 'inner' is the site-wide nav. */
  variant?: 'home' | 'inner';
  /** href of the nav item to mark as current. */
  active?: string;
  showBanner?: boolean;
  /** Overrides the CTA target, e.g. an in-page anchor on the kontakt page. */
  cta?: string;
}

const { variant = 'home', active = '', showBanner = true, cta } = Astro.props;
const inner = variant === 'inner';

const homeNav = [
  { n: '01', label: 'Usluge', href: '/usluge' },
  { n: '02', label: 'Rokovi', href: '#rokovi' },
  { n: '03', label: 'Paketi', href: '#paketi' },
  { n: '04', label: 'Cenovnik', href: '/cenovnik' },
  { n: '05', label: 'O nama', href: '/o-nama' },
  { n: '06', label: 'FAQ', href: '#faq' },
];

const innerNav = [
  { n: '00', label: 'Početna', href: '/' },
  { n: '01', label: 'Usluge', href: '/usluge' },
  { n: '02', label: 'Cenovnik', href: '/cenovnik' },
  { n: '03', label: 'O nama', href: '/o-nama' },
  { n: '04', label: 'Kontakt', href: '/kontakt' },
];

const nav = inner ? innerNav : homeNav;
const bannerHref = inner ? '/#provera' : '#provera';
const logoHref = inner ? '/' : '#pp-root';
const ctaHref = cta ?? (inner ? '/kontakt' : '#kontakt');
const navStyle = inner
  ? "display:flex; gap:26px; flex-wrap:wrap; justify-content:center; font:500 12.5px 'IBM Plex Mono',monospace"
  : "display:flex; gap:26px; flex-wrap:wrap; justify-content:center; font:500 12.5px 'IBM Plex Mono',monospace; letter-spacing:.02em";
// Traka sa rokom je zuta sa crnim tekstom na svim stranama.
const bannerStyle =
  'background:#FECB0F; color:#070707; display:flex; align-items:center; justify-content:center; gap:20px; flex-wrap:wrap; padding:9px 20px; text-align:center';
const bannerLinkStyle =
  "font:700 11.5px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:#070707; text-decoration:underline; text-underline-offset:3px";

// 1. januar 2027. u 00:00 po srednjoevropskom vremenu.
const target = Date.parse('2027-01-01T00:00:00+01:00');
const days = Math.max(0, Math.floor((target - Date.now()) / 864e5));
---

{showBanner && (
<div class="hdr-banner" style={bannerStyle}>
  <span style="font:600 11.5px 'IBM Plex Mono',monospace; letter-spacing:.14em; font-variant-numeric:tabular-nums">ČETIRI NOVA PRAVILNIKA SE PRIMENJUJU OD 01.01.2027. · JOŠ <span data-cd="days">{days}</span> DANA</span>
  <a href={bannerHref} class="hdr-banner-a" style={bannerLinkStyle}>PROVERITE OBAVEZE →</a>
</div>
)}

<div style="position:sticky; top:0; z-index:60; background:#040404; border-bottom:1px solid rgba(254,203,15,.16)">
  <div class="hdr-bar" style="max-width:1360px; margin:0 auto; padding:0 32px; height:64px; display:flex; align-items:center; justify-content:space-between; gap:24px">
    <a href={logoHref} class="hdr-logo" style="display:flex; align-items:center; gap:11px; flex:none; color:#fff">
      <Wordmark />
    </a>
    <nav class="hdr-nav" style={navStyle}>
      {nav.map((item) => (
        <a href={item.href} class="hdr-a" style={item.href === active ? 'color:#FECB0F' : 'color:rgba(255,255,255,.75)'}><span style="color:rgba(254,203,15,.6)">{item.n}</span> {item.label}</a>
      ))}
    </nav>
    <div class="hdr-right" style="display:flex; align-items:center; gap:16px; flex:none">
      <span class="hdr-scripts" data-no-cyr style="display:flex; align-items:center; gap:5px; font:500 11px 'IBM Plex Mono',monospace">
        <button type="button" data-script-btn="cir" aria-pressed="false" style="all:unset; cursor:pointer; padding:12px 2px; color:rgba(255,255,255,.5)">ЋИР</button>
        <span style="color:rgba(255,255,255,.3)">/</span>
        <button type="button" data-script-btn="lat" aria-pressed="true" style="all:unset; cursor:pointer; padding:12px 2px; color:#FECB0F; text-decoration:underline; text-underline-offset:4px">LAT</button>
      </span>
      <a href={ctaHref} class="hdr-cta" style="background:#FECB0F; color:#070707; font:700 13px 'IBM Plex Sans',system-ui,sans-serif; padding:11px 18px; flex:none">Zatražite ponudu</a>
      <button type="button" class="tape-btn" id="hdr-tape" aria-expanded="false" aria-controls="hdr-menu" aria-label="Meni">
        <svg class="tape-ico" viewBox="0 0 48 48" aria-hidden="true">
          <defs>
            <!-- Kosa zuto-crna sara trake upozorenja; korak 12 na 45 stepeni. -->
            <pattern id="tape-hz" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <rect width="12" height="12" fill="#FECB0F"></rect>
              <rect width="6" height="12" fill="#0d0d0d"></rect>
            </pattern>
          </defs>
          <!-- Tri odsecka trake: zatvoreno su hamburger, otvoreno se ukrste u X. -->
          <rect class="tape-bar tape-bar1" x="6" y="12" width="36" height="5.5" rx="1" fill="url(#tape-hz)"></rect>
          <rect class="tape-bar tape-bar2" x="6" y="21.25" width="36" height="5.5" rx="1" fill="url(#tape-hz)"></rect>
          <rect class="tape-bar tape-bar3" x="6" y="30.5" width="36" height="5.5" rx="1" fill="url(#tape-hz)"></rect>
        </svg>
      </button>
    </div>
  </div>
</div>

<nav class="tape-menu" id="hdr-menu" aria-label="Glavna navigacija">
  <i class="tape-seal tape-seal-top" aria-hidden="true"></i>
  <div class="tape-menu-grid">
    {nav.map((item) => (
      <a href={item.href}><span>{item.n}</span>{item.label}<i class="tape-line" aria-hidden="true"></i></a>
    ))}
  </div>
  <a href={ctaHref} class="tape-menu-cta">Zatražite ponudu</a>
  <div class="tape-menu-foot">
    <span data-no-cyr style="display:flex; align-items:center; gap:5px; font:500 12px 'IBM Plex Mono',monospace">
      <button type="button" data-script-btn="cir" aria-pressed="false" style="all:unset; cursor:pointer; padding:10px 2px; color:rgba(255,255,255,.5)">ЋИР</button>
      <span style="color:rgba(255,255,255,.3)">/</span>
      <button type="button" data-script-btn="lat" aria-pressed="true" style="all:unset; cursor:pointer; padding:10px 2px; color:#FECB0F; text-decoration:underline; text-underline-offset:4px">LAT</button>
    </span>
    <a href={firma.telefonHref}>{firma.telefon}</a>
  </div>
  <i class="tape-seal tape-seal-bot" aria-hidden="true"></i>
</nav>

<style>
  /* Own hover rules, so the bar behaves the same on dark and light pages.
     !important is required: the base colors sit in inline style attributes,
     which otherwise win over any stylesheet rule. */
  .hdr-a:hover { color: #FECB0F !important; text-decoration: none !important; }
  .hdr-logo:hover { text-decoration: none !important; }
  .hdr-cta:hover { background: #fff !important; color: #070707 !important; text-decoration: none !important; }
  /* Bez ovoga globalno a:hover na tamnim stranama oboji link u zuto, pa
     nestane na zutoj traci. Ostaje crn i podvucen na svim stranama. */
  .hdr-banner-a:hover { color: #070707 !important; text-decoration: underline !important; }

  /* ---- traka upozorenja: dugme koje zamenjuje navigaciju na tabletu i telefonu ---- */
  .tape-btn {
    all: unset;
    width: 46px;
    height: 46px;
    display: none; /* vidljivo samo ispod 900px */
    place-items: center;
    cursor: pointer;
    flex: none;
    -webkit-tap-highlight-color: transparent;
  }
  .tape-btn:focus-visible { outline: 2px solid #FECB0F; outline-offset: 2px; }
  .tape-ico { width: 38px; height: 38px; display: block; overflow: visible; }

  /* Zatvoreno: tri odsecka trake, zalepljena rukom, svaki pod svojim uglom.
     Otvoreno: gornji i donji se ukrste u X, srednji se smota na rolnu. */
  .tape-bar {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform .42s cubic-bezier(.34, 1.3, .5, 1);
  }
  .tape-bar1 { transform: rotate(-2.2deg); }
  .tape-bar2 { transform: rotate(1.4deg); }
  .tape-bar3 { transform: rotate(-1.1deg); }
  .tape-btn[aria-expanded="true"] .tape-bar1 { transform: translateY(9.25px) rotate(45deg); }
  .tape-btn[aria-expanded="true"] .tape-bar2 { transform: scaleX(0); }
  .tape-btn[aria-expanded="true"] .tape-bar3 { transform: translateY(-9.25px) rotate(-45deg); }

  /* ---- meni preko celog ekrana: traka se odmotava red po red ---- */
  .tape-menu {
    --tape: repeating-linear-gradient(45deg, #FECB0F 0 9px, #0d0d0d 9px 18px);
    position: fixed;
    inset: 0;
    z-index: 59; /* ispod trake (60), pa dugme ostaje vidljivo i pritisljivo */
    background: rgba(4, 4, 4, .97);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    display: none;
    flex-direction: column;
    justify-content: center;
    padding: 96px 24px 40px;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity .22s ease;
  }
  .tape-menu.open { opacity: 1; pointer-events: auto; }

  /* Traka se odmotava zdesna, odakle stoji dugme. Sirina raste umesto
     scaleX, da se kosa sara ne razvuce dok putuje. */
  .tape-seal {
    position: absolute;
    right: -6%;
    width: 0;
    height: 14px;
    background-image: var(--tape);
    background-position: right center;
    transition: width .44s cubic-bezier(.22, .61, .36, 1);
  }
  .tape-seal-top { top: 72px; transform: rotate(-1.6deg); }
  .tape-seal-bot { bottom: 52px; transform: rotate(1.1deg); }
  .tape-menu.open .tape-seal { width: 112%; }
  .tape-menu.open .tape-seal-top { transition-delay: .05s; }
  .tape-menu.open .tape-seal-bot { transition-delay: .12s; }

  .tape-menu-grid { display: grid; gap: 2px; max-width: 520px; width: 100%; margin: 0 auto; }
  .tape-menu-grid a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 4px 16px;
    font: 800 clamp(22px, 6.4vw, 32px)/1.05 'IBM Plex Sans', system-ui, sans-serif;
    letter-spacing: -.03em;
    color: #fff;
  }
  .tape-menu-grid a span { font: 700 12px 'IBM Plex Mono', monospace; color: #FECB0F; flex: none; }
  /* Naslov se pojavi tek kad traka prodje ispod njega. */
  .tape-menu-grid a > span, .tape-menu-grid a { transition: opacity .3s ease, transform .3s ease; }
  .tape-menu-grid a { opacity: 0; transform: translateY(10px); }
  .tape-menu.open .tape-menu-grid a { opacity: 1; transform: none; }
  /* Odmotana traka stoji umesto crte ispod stavke. */
  .tape-line {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 0;
    height: 7px;
    background-image: var(--tape);
    background-position: right center;
    transition: width .32s cubic-bezier(.22, .61, .36, 1);
  }
  .tape-menu.open .tape-line { width: 100%; }
  .tape-menu.open .tape-menu-grid a:nth-child(1), .tape-menu.open .tape-menu-grid a:nth-child(1) .tape-line { transition-delay: .16s; }
  .tape-menu.open .tape-menu-grid a:nth-child(2), .tape-menu.open .tape-menu-grid a:nth-child(2) .tape-line { transition-delay: .21s; }
  .tape-menu.open .tape-menu-grid a:nth-child(3), .tape-menu.open .tape-menu-grid a:nth-child(3) .tape-line { transition-delay: .26s; }
  .tape-menu.open .tape-menu-grid a:nth-child(4), .tape-menu.open .tape-menu-grid a:nth-child(4) .tape-line { transition-delay: .31s; }
  .tape-menu.open .tape-menu-grid a:nth-child(5), .tape-menu.open .tape-menu-grid a:nth-child(5) .tape-line { transition-delay: .36s; }
  .tape-menu.open .tape-menu-grid a:nth-child(6), .tape-menu.open .tape-menu-grid a:nth-child(6) .tape-line { transition-delay: .41s; }

  /* Dugme za ponudu zivi u meniju samo tamo gde je sklonjeno iz trake. */
  .tape-menu-cta {
    display: none;
    max-width: 520px;
    width: 100%;
    margin: 24px auto 0;
    box-sizing: border-box;
    padding: 14px 18px;
    background: #FECB0F;
    color: #070707;
    text-align: center;
    font: 700 15px 'IBM Plex Sans', system-ui, sans-serif;
    opacity: 0;
    transition: opacity .34s ease;
  }
  .tape-menu.open .tape-menu-cta { opacity: 1; transition-delay: .46s; }
  .tape-menu-foot {
    max-width: 520px;
    width: 100%;
    margin: 26px auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font: 600 12px 'IBM Plex Mono', monospace;
    color: rgba(255, 255, 255, .5);
    opacity: 0;
    transition: opacity .34s ease;
  }
  .tape-menu.open .tape-menu-foot { opacity: 1; transition-delay: .5s; }
  .tape-menu-foot a { font: 700 15px 'IBM Plex Mono', monospace; color: #FECB0F; }

  /* Tablet i telefon: navigacija u traci nestaje, dugme je preuzima.
     Desktop iznad 900px ostaje netaknut. */
  @media (max-width: 900px) {
    .hdr-bar {
      height: 56px !important;
      padding: 0 16px !important;
      gap: 12px !important;
    }
    .hdr-nav { display: none !important; }
    .hdr-scripts { display: none !important; } /* prekidač živi u meniju */
    .hdr-right { gap: 8px !important; }
    .tape-btn { display: grid; }
    .tape-menu { display: flex; }
    /* Traka sa rokom ide samo na desktop. Na telefonu i tabletu zauzima
       pola prvog ekrana, a isti rok stoji nize u sadrzaju strane. */
    .hdr-banner { display: none !important; }
  }

  /* Telefon: dugme za ponudu iz trake stiska logo i meni, pa se seli u meni. */
  @media (max-width: 640px) {
    .hdr-cta { display: none !important; }
    .tape-menu-cta { display: block; }
  }

  /* Najuži telefoni: logo i dugme moraju stati u 320px. */
  @media (max-width: 360px) {
    .hdr-bar { padding: 0 12px !important; gap: 8px !important; }
    .hdr-logo { gap: 8px !important; }
    /* Znak dolazi iz Wordmark.astro, pa ima svoj data-astro-cid: bez :global()
       ovo pravilo ne bi pogodilo nista. Skupljanje stoji ovde a ne u samoj
       komponenti, jer je to ogranicenje trake sa menijem, a ne osobina znaka:
       u podnozju ima mesta i znak ostaje pun.
       Cirilica je sira od latinice ("ПРЕВЕНТИВНИ ИНЖЕЊЕРИНГ"), pa potpis
       mora da ima rezervu da stane i u jednom i u drugom pismu. */
    .hdr-logo :global(.wm-name) { font-size: 13px !important; }
    .hdr-logo :global(.wm-tag) { font-size: 7.5px !important; letter-spacing: .1em !important; }
    .hdr-right { gap: 4px !important; }
    .tape-btn { width: 40px; height: 40px; }
    .tape-ico { width: 34px; height: 34px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tape-bar, .tape-menu, .tape-seal, .tape-line, .tape-menu-grid a, .tape-menu-cta, .tape-menu-foot { transition: none !important; animation: none !important; }
  }
</style>

<script>
  // ---------- Pismo: latinica <-> cirilica ----------
  // Srpski je 1:1 preslikavanje, osim tri digrafa koji moraju ici prvi.
  const MAP: Record<string, string> = {
    'DŽ': 'Џ', 'Dž': 'Џ', 'dž': 'џ',
    'LJ': 'Љ', 'Lj': 'Љ', 'lj': 'љ',
    'NJ': 'Њ', 'Nj': 'Њ', 'nj': 'њ',
    A: 'А', B: 'Б', C: 'Ц', Č: 'Ч', Ć: 'Ћ', D: 'Д', Đ: 'Ђ', E: 'Е', F: 'Ф',
    G: 'Г', H: 'Х', I: 'И', J: 'Ј', K: 'К', L: 'Л', M: 'М', N: 'Н', O: 'О',
    P: 'П', R: 'Р', S: 'С', Š: 'Ш', T: 'Т', U: 'У', V: 'В', Z: 'З', Ž: 'Ж',
    a: 'а', b: 'б', c: 'ц', č: 'ч', ć: 'ћ', d: 'д', đ: 'ђ', e: 'е', f: 'ф',
    g: 'г', h: 'х', i: 'и', j: 'ј', k: 'к', l: 'л', m: 'м', n: 'н', o: 'о',
    p: 'п', r: 'р', s: 'с', š: 'ш', t: 'т', u: 'у', v: 'в', z: 'з', ž: 'ж',
  };
  // Duzi kljucevi prvi, da 'lj' pobedi 'l' + 'j'.
  const RE = new RegExp(
    Object.keys(MAP).sort((a, b) => b.length - a.length).join('|'),
    'g'
  );

  // Strana imena i robne marke ostaju latinicom.
  const KEEP = new Set([
    'Preving', 'PREVING', 'Pro', 'PRO', 'Slovnaft', 'MOL', 'Unipetrol', 'OMV',
    'INA', 'Alcovisor', 'Mark', 'Plus', 'SAM', 'Industries', 'ABEP', 'Toolbox',
    'USB', 'LAT',
    // Q, W, X i Y nemaju cirilicni par: bez ovoga bi FAQ postao "ФАQ".
    'FAQ',
  ]);
  // Reci u kojima lj/nj/dz NISU digrafi. Danasnji tekst ih nema, ali nova
  // kopija moze da ih uvede, pa se ovde stite.
  const FALSE_DIGRAPH: Record<string, string> = {
    injekcija: 'инјекција', injekcije: 'инјекције', konjunktura: 'конјунктура',
    nadziveti: 'надживети', nadzanr: 'наджанр', podzanr: 'поджанр',
    tanjug: 'Танјуг', vanjezicki: 'ванјезички',
  };

  const stripEdges = (t: string) => t.replace(/^[^\wČčĆćĐđŠšŽž]+|[^\wČčĆćĐđŠšŽž]+$/g, '');

  const toCyr = (s: string) =>
    s.replace(/\S+/g, (tok) => {
      const bare = stripEdges(tok);
      if (!bare) return tok;
      if (KEEP.has(bare)) return tok;
      if (tok.includes('@')) return tok;                       // imejl
      if (/^(https?:|www\.)/i.test(tok)) return tok;           // adresa
      if (/\.(rs|com|net|org|io)\b/i.test(tok)) return tok;    // domen
      const fd = FALSE_DIGRAPH[bare.toLowerCase()];
      if (fd) return tok.replace(bare, fd);
      return tok.replace(RE, (m) => MAP[m]);
    });

  // Cuva se latinicni original i ono sto smo poslednje upisali, da bismo
  // razlikovali svoju izmenu od izmene koju je napravila stranica.
  const source = new WeakMap<Text, string>();
  const written = new WeakMap<Text, string>();
  let mode: 'lat' | 'cir' = 'lat';
  try {
    if (localStorage.getItem('pp-script') === 'cir') mode = 'cir';
  } catch (e) {
    /* privatni rezim: ostaje latinica */
  }

  const skip = (t: Text) => {
    const p = t.parentElement;
    return !p || !!p.closest('script,style,noscript,[data-no-cyr]');
  };

  // Mora da prihvati i cirilicu: kad je tekst vec preveden, povratak na
  // latinicu bi bio preskocen da se trazi samo latinicno slovo.
  const HAS_LETTER = /[A-Za-zČčĆćĐđŠšŽžЀ-ӿ]/;

  const convertNode = (t: Text) => {
    if (skip(t)) return;
    const now = t.nodeValue;
    if (!now || !HAS_LETTER.test(now)) return;
    // Ako tekst nije onaj koji smo mi upisali, stranica ga je promenila:
    // uzmi novu vrednost kao novi original.
    if (written.get(t) !== now) source.set(t, now);
    const src = source.get(t) as string;
    const out = mode === 'cir' ? toCyr(src) : src;
    if (t.nodeValue !== out) t.nodeValue = out;
    written.set(t, out);
  };

  const convertTree = (root: Node) => {
    if (root.nodeType === 3) return convertNode(root as Text);
    if (root.nodeType !== 1 && root.nodeType !== 9 && root.nodeType !== 11) return;
    const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const list: Text[] = [];
    let n: Node | null;
    while ((n = w.nextNode())) list.push(n as Text);
    list.forEach(convertNode);
  };

  let titleSrc = document.title;
  const applyScript = () => {
    convertTree(document.body);
    document.title = mode === 'cir' ? toCyr(titleSrc) : titleSrc;
    document.documentElement.lang = mode === 'cir' ? 'sr-Cyrl' : 'sr-Latn';
    document.querySelectorAll<HTMLElement>('[data-script-btn]').forEach((b) => {
      const on = b.dataset.scriptBtn === mode;
      b.style.color = on ? '#FECB0F' : 'rgba(255,255,255,.5)';
      b.setAttribute('aria-pressed', String(on));
    });
  };
  // Stranice koje same menjaju tekst (sat, procena, rezultat ankete) ne moraju
  // nista da znaju: posmatrac prevede sve sto se doda ili promeni.
  new MutationObserver((muts) => {
    if (mode !== 'cir') return;
    for (const m of muts) {
      if (m.type === 'childList') m.addedNodes.forEach(convertTree);
      else if (m.type === 'characterData') convertNode(m.target as Text);
    }
  }).observe(document.body, { childList: true, characterData: true, subtree: true });

  document.querySelectorAll<HTMLElement>('[data-script-btn]').forEach((b) => {
    b.addEventListener('click', () => {
      mode = b.dataset.scriptBtn === 'cir' ? 'cir' : 'lat';
      try {
        localStorage.setItem('pp-script', mode);
      } catch (e) {
        /* bez pamcenja izbora */
      }
      applyScript();
    });
  });
  applyScript();

  const btn = document.getElementById('hdr-tape');
  const menu = document.getElementById('hdr-menu');

  if (btn && menu) {
    const setOpen = (v: boolean) => {
      btn.setAttribute('aria-expanded', String(v));
      menu.classList.toggle('open', v);
      document.body.style.overflow = v ? 'hidden' : '';
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    // Ako se prozor raširi iznad 900px dok je meni otvoren, zatvori ga.
    matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
