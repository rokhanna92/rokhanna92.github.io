---
import services from '../data/services.json';
import { cena } from '../lib/cene';
import { firma } from '../lib/firma';
import Wordmark from './Wordmark.astro';

interface Props {
  /** Prefix for the service anchors: '/usluge' from elsewhere, '' when already on that page. */
  serviceHref?: string;
  /** Fifth link in the USLUGE column, or null to leave the column at four. */
  lastLink?: { href: string; label: string } | null;
}

const {
  serviceHref = '/usluge',
  lastLink = { href: '#paketi', label: cena('pausal-pro').naziv },
} = Astro.props;

const updated = '21.08.2026.';
---

<footer style="position:relative; z-index:2; background:#040404; color:#F2F1EC; border-top:1px solid rgba(255,255,255,.1); padding:64px 32px 0">
  <div style="max-width:1360px; margin:0 auto">
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr)); gap:40px; padding-bottom:48px">
      <div>
        <div style="display:flex; align-items:center; gap:11px; margin-bottom:16px">
          <Wordmark />
        </div>
        <p style="margin:0; font:400 13px/1.7 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.5)">{firma.pravnoIme}<br />{firma.adresa}, {firma.grad}<br />{firma.sifraDelatnosti}</p>
      </div>
      <div>
        <p style="margin:0 0 14px; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.2em; color:rgba(255,255,255,.4)">USLUGE</p>
        <div style="display:grid; gap:10px; font:400 14px 'IBM Plex Sans',system-ui,sans-serif">
          {services.map((s) => (
            <a href={`${serviceHref}#${s.id}`} class="ftr-a" style="color:rgba(255,255,255,.75)">{s.title}</a>
          ))}
          {lastLink && <a href={lastLink.href} class="ftr-a" style="color:rgba(255,255,255,.75)">{lastLink.label}</a>}
        </div>
      </div>
      <div>
        <p style="margin:0 0 14px; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.2em; color:rgba(255,255,255,.4)">LICENCE</p>
        <p style="margin:0; font:400 13px/1.8 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.5)">Savetnik za BZR<br />Koordinator u fazi izvođenja radova<br />Referent zaštite od požara<br /><span style="color:rgba(255,255,255,.35)">Inspektorat za rad · MUP RS</span></p>
      </div>
      <div>
        <p style="margin:0 0 14px; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.2em; color:rgba(255,255,255,.4)">KONTAKT</p>
        <div style="display:grid; gap:10px; font:500 13.5px 'IBM Plex Mono',monospace">
          <a href={firma.telefonHref} class="ftr-a" style="color:#FECB0F">{firma.telefon}</a>
          {firma.imejlovi.map((imejl) => (
            <a href={`mailto:${imejl}`} class="ftr-a" style="color:rgba(255,255,255,.75)">{imejl}</a>
          ))}
          <span style="color:rgba(255,255,255,.45)">{firma.radnoVreme}</span>
        </div>
      </div>
    </div>
    <div style="border-top:1px solid rgba(255,255,255,.1); padding:20px 0 24px; display:flex; flex-wrap:wrap; justify-content:space-between; gap:14px; font:400 12px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.35)">
      <span>© 2026 Preving Pro · Politika privatnosti · Uslovi korišćenja</span>
      <span>ЋИР / LAT · Ažurirano: {updated}</span>
    </div>
  </div>
</footer>

<button type="button" class="to-top" id="to-top">
  <span class="chip">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V6"></path><path d="m6 12 6-6 6 6"></path>
    </svg>
  </span>
  <span class="to-top-sr">Nazad na vrh</span>
</button>

<style>
  /* Own hover rules, so the footer behaves the same on dark and light pages.
     !important is required: the base colors sit in inline style attributes,
     which otherwise win over any stylesheet rule. */
  .ftr-a:hover { color: #FECB0F !important; text-decoration: none !important; }

  /* ---- Povratak na vrh ---- */
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    /* Ispod menija kupe (59) i trake (60), pa ga otvoren meni prekrije. */
    z-index: 40;
    /* Meta za prst ostaje 44px, ali se vidi samo manji kvadrat unutra. */
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: none;
    background: none;
    color: #FECB0F;
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity .3s ease, transform .3s ease;
    -webkit-tap-highlight-color: transparent;
  }
  /* Vidljivi znak: tanak okvir na tamnoj podlozi, radi i na svetloj strani. */
  .to-top span.chip {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: #070707;
    border: 1px solid rgba(254, 203, 15, .34);
    transition: background .2s ease, border-color .2s ease, color .2s ease;
  }
  .to-top.on { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:hover span.chip { background: #FECB0F; border-color: #FECB0F; color: #070707; }
  .to-top:focus-visible { outline: 2px solid #FECB0F; outline-offset: 1px; }
  /* Naziv je pravi tekst, ne aria-label, da ga prebacivanje pisma prevede. */
  .to-top-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .to-top { right: 10px; bottom: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .to-top { transition: none; }
  }

  /* Veće mete za prst na telefonu. */
  @media (max-width: 900px) {
    .ftr-a { display: inline-block; padding: 9px 0; }
  }
</style>

<script>
  // ---- Paralaksa: obelezena sekcija zaostaje za skrolom, pa sledeca
  // sekcija (veci z-index) klizi preko nje. data-parallax="hero" racuna od
  // vrha strane, svaka druga vrednost od sopstvenog polozaja. ----
  const pxEls = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  if (pxEls.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let pxRaf = 0;
    // Koliko sme da se pomeri sekcija pred podnozjem: najvise njen donji
    // unutrasnji razmak, da podnozje pokrije prazninu a ne tekst. Razmak se
    // menja po sirini ekrana, pa se mera osvezava uz promenu velicine.
    let pxCaps = new WeakMap<HTMLElement, number>();
    const measure = () => {
      pxCaps = new WeakMap();
      for (const el of pxEls) {
        if (el.dataset.parallax !== 'pre') continue;
        const pad = parseFloat(getComputedStyle(el).paddingBottom) || 0;
        // Pola razmaka, najvise 56px, ostaje kao vazduh izmedju poslednjeg
        // dugmeta i ivice podnozja. Ostatak sme da se pojede pomeranjem.
        const cap = Math.max(0, pad - Math.min(56, pad * 0.5));
        pxCaps.set(el, cap);
        // data-pull: sekcija se podigne tacno za svoj hod, pa spustanje ne
        // otvara procep iznad nje. U mirovanju naleze tacno na donji rub
        // prethodne sekcije. Stoji samo tamo gde se boja sekcije razlikuje od
        // pozadine strane, jer se procep inace i ne vidi.
        if (el.hasAttribute('data-pull')) el.style.marginTop = cap ? -cap + 'px' : '';
      }
    };
    const paint = () => {
      pxRaf = 0;
      const y = window.scrollY || 0;
      for (const el of pxEls) {
        const h = el.offsetHeight || 1;
        const mode = el.dataset.parallax;
        let shift: number;
        if (mode === 'hero') {
          shift = Math.min(y * 0.45, h * 0.6);
        } else {
          // offsetTop lanac, ne getBoundingClientRect: rect vec sadrzi nas
          // transform, pa bi racun sam sebe hranio.
          let node: HTMLElement | null = el;
          let top = 0;
          while (node) {
            top += node.offsetTop;
            node = node.offsetParent as HTMLElement | null;
          }
          if (mode === 'pre') {
            // Sekcija pred podnozjem nikad ne prodje vrh ekrana, jer ispod nje
            // stoji samo podnozje. Zato se racuna od ulaska u vidno polje.
            const seen = window.innerHeight + y - top;
            shift = Math.min(Math.max(seen * 0.22, 0), pxCaps.get(el) ?? 0);
          } else {
            shift = Math.min(Math.max((y - top) * 0.45, 0), h * 0.6);
          }
        }
        el.style.transform = 'translateY(' + shift.toFixed(1) + 'px)';
      }
    };
    const onPxScroll = () => {
      if (pxRaf) return;
      pxRaf = requestAnimationFrame(paint);
    };
    const onPxResize = () => {
      measure();
      onPxScroll();
    };
    window.addEventListener('scroll', onPxScroll, { passive: true });
    window.addEventListener('resize', onPxResize, { passive: true });
    measure();
    paint();
    // Razmak zavisi od preloma teksta, pa se mera ponavlja kad font stigne.
    document.fonts?.ready.then(onPxResize);
  }

  const toTop = document.getElementById('to-top');
  if (toTop) {
    let raf = 0;
    const sync = () => {
      raf = 0;
      toTop.classList.toggle('on', window.scrollY > 600);
    };
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(sync);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    sync();
    toTop.addEventListener('click', () => {
      // html ima scroll-behavior:smooth, pa se ovde izricito trazi skok
      // kada korisnik trazi manje pokreta.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
