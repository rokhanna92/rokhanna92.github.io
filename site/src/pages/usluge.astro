---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import usluge from '../data/usluge.json';
import chips from '../data/price-chips.json';
import { cena } from '../lib/cene';
import '../styles/responsive.css';

const { bzr, zop, koordinator, obuke } = usluge;

// Cip je jedan red velikih slova, pa i "od" iz iznosa ide u velika.
const cip = (c: { label: string; ref: string; suffix: string }) =>
  `${c.label} · ${cena(c.ref).iznos.toUpperCase()} ${c.suffix}`.trim();

// Jedan red u ZOP tabeli nema stavku u cenovniku, pa nosi svoj tekst.
const iznosReda = (row: { ref?: string; value?: string }) => (row.ref ? cena(row.ref).iznos : row.value);

// Staggered reveal, mirroring the mockup: prvi element bez kašnjenja.
const delay = (i: number, step: number) => (i === 0 ? '' : `; transition-delay:${(i * step) / 100}s`);

const title = 'Usluge · Preving Pro';
const description =
  'Sve što zakon traži od poslodavca, iz jedne ruke: dokumentacija, obuke, kontrole i zastupanje. BZR, zaštita od požara, koordinator gradilišta i obuke zaposlenih.';
---

<!doctype html>
<html lang="sr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
    />
    <style is:global>
      html{scroll-behavior:smooth}
      body{margin:0;background:#040404;font-family:'IBM Plex Sans',system-ui,sans-serif;color:#F2F1EC;-webkit-font-smoothing:antialiased;text-wrap:pretty}
      a{color:#F2F1EC;text-decoration:none}
      a:hover{color:#FECB0F}
      ::selection{background:#FECB0F;color:#070707}
      @keyframes blink{0%,45%{opacity:1}50%,95%{opacity:.12}100%{opacity:1}}
      @keyframes dash{to{stroke-dashoffset:-48}}
      @keyframes needle{0%,100%{transform:rotate(-24deg)}50%{transform:rotate(26deg)}}
      @keyframes flowY{to{background-position:0 26px}}
      [data-wp]{clip-path:inset(0 100% 0 0);transition:clip-path 1s cubic-bezier(.2,.6,.2,1)}
      .wp-on{clip-path:inset(0 0 0 0) !important}
      [data-fd]{opacity:0;transform:translateX(-14px);transition:opacity .55s ease,transform .55s ease}
      .fd-on{opacity:1 !important;transform:none !important}
      @media (prefers-reduced-motion:reduce){[data-wp],[data-fd]{clip-path:none;opacity:1;transform:none;transition:none}}

      /* !important je obavezan: osnovne boje su u inline style atributima,
         koji inače pobeđuju svako pravilo iz stilova. */
      .btn-y:hover{background:#fff !important;color:#070707 !important}
      .btn-dark:hover{background:#1c1c1c !important;color:#FECB0F !important}
      .btn-outline:hover{background:#070707 !important;color:#FECB0F !important}
      .chip-link:hover{border-color:#FECB0F !important;color:#FECB0F !important}

      /* Na telefonu crtež cevovoda ide iza teksta pa mora da se povuče. */
      @media (max-width:900px){.hero-pid{opacity:.22 !important}}
    </style>
  </head>
  <body>
    <div id="pg-usluge">
      <Header variant="inner" active="/usluge" />

      <section data-parallax="hero" style="position:relative; z-index:0; will-change:transform; background:#040404; overflow:hidden; padding:88px 32px 64px">
        <svg class="hero-pid" viewBox="0 0 640 420" preserveAspectRatio="xMaxYMid slice" style="position:absolute; right:0; top:0; height:100%; width:min(58vw,760px); opacity:.85" aria-hidden="true">
          <path d="M-20 90 H320 V230 H660" fill="none" stroke="#222222" stroke-width="10"></path>
          <path d="M140 440 V150 H660" fill="none" stroke="#1c1c1c" stroke-width="10"></path>
          <path d="M-20 310 H430 V60 H660" fill="none" stroke="#262626" stroke-width="10"></path>
          <path d="M-20 90 H320 V230 H660" fill="none" stroke="#FECB0F" stroke-width="2.4" stroke-dasharray="10 16" opacity=".75" style="animation:dash 1.5s linear infinite"></path>
          <path d="M140 440 V150 H660" fill="none" stroke="#FECB0F" stroke-width="2.4" stroke-dasharray="10 16" opacity=".45" style="animation:dash 2.3s linear infinite"></path>
          <path d="M-20 310 H430 V60 H660" fill="none" stroke="#FECB0F" stroke-width="2.4" stroke-dasharray="10 16" opacity=".6" style="animation:dash 1.9s linear infinite"></path>
          <circle cx="320" cy="90" r="7" fill="#040404" stroke="#3a3a3a" stroke-width="3"></circle>
          <circle cx="320" cy="230" r="7" fill="#040404" stroke="#3a3a3a" stroke-width="3"></circle>
          <circle cx="140" cy="150" r="7" fill="#040404" stroke="#3a3a3a" stroke-width="3"></circle>
          <circle cx="430" cy="310" r="7" fill="#040404" stroke="#3a3a3a" stroke-width="3"></circle>
          <path d="M488 218 L512 242 M512 218 L488 242" stroke="#FECB0F" stroke-width="3"></path>
          <circle cx="500" cy="230" r="16" fill="none" stroke="#FECB0F" stroke-width="2"></circle>
          <circle cx="430" cy="60" r="26" fill="#0a0a0a" stroke="#3a3a3a" stroke-width="3"></circle>
          <line x1="430" y1="60" x2="446" y2="46" stroke="#FECB0F" stroke-width="2.5" style="transform-box:view-box; transform-origin:430px 60px; animation:needle 3.8s ease-in-out infinite"></line>
          <circle cx="430" cy="60" r="3" fill="#FECB0F"></circle>
        </svg>
        <div style="position:absolute; inset:0; background:linear-gradient(90deg,#040404 34%,rgba(4,4,4,.55) 62%,rgba(4,4,4,.15)); pointer-events:none"></div>
        <div style="max-width:1360px; margin:0 auto; position:relative">
          <p style="margin:0 0 20px; font:500 11.5px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.45); letter-spacing:.2em"><a href="/" style="color:rgba(255,255,255,.45)">POČETNA</a> / <span style="color:#FECB0F">USLUGE</span></p>
          <h1 data-wp style="margin:0; font:700 clamp(38px,4.6vw,68px)/1 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.035em; color:#fff; max-width:14ch">Četiri discipline. Jedan standard.</h1>
          <p style="margin:22px 0 0; font:400 17px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.68); max-width:56ch">Sve što zakon traži od poslodavca, iz jedne ruke: dokumentacija, obuke, kontrole i zastupanje. Ispod je tačno šta radimo, šta dobijate i šta koliko košta.</p>
          <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:32px">
            <a href="#bzr" class="chip-link" style="border:1px solid rgba(255,255,255,.3); font:600 12.5px 'IBM Plex Mono',monospace; padding:11px 16px; color:rgba(255,255,255,.85)">1.1 BZR</a>
            <a href="#zop" class="chip-link" style="border:1px solid rgba(255,255,255,.3); font:600 12.5px 'IBM Plex Mono',monospace; padding:11px 16px; color:rgba(255,255,255,.85)">1.2 ZAŠTITA OD POŽARA</a>
            <a href="#koordinator" class="chip-link" style="border:1px solid rgba(255,255,255,.3); font:600 12.5px 'IBM Plex Mono',monospace; padding:11px 16px; color:rgba(255,255,255,.85)">1.3 KOORDINATOR</a>
            <a href="#obuke" class="chip-link" style="border:1px solid rgba(255,255,255,.3); font:600 12.5px 'IBM Plex Mono',monospace; padding:11px 16px; color:rgba(255,255,255,.85)">1.4 OBUKE</a>
          </div>
        </div>
      </section>

      <section id="bzr" style="position:relative; z-index:2; box-shadow:0 -30px 60px rgba(0,0,0,.55); background:#070707; border-top:1px solid rgba(255,255,255,.09); padding:88px 32px 92px">
        <div style="max-width:1360px; margin:0 auto; position:relative; padding-left:44px">
          <div style="position:absolute; left:0; top:6px; bottom:6px; width:3px; background:repeating-linear-gradient(180deg,#FECB0F 0 10px,transparent 10px 26px); animation:flowY 1.2s linear infinite" aria-hidden="true"></div>
          <div style="display:flex; flex-wrap:wrap; gap:56px">
            <div style="flex:1 1 480px; min-width:0">
              <p style="margin:0 0 12px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(254,203,15,.7)">USLUGA 1.1</p>
              <h2 data-wp style="margin:0 0 18px; font:700 clamp(30px,3.4vw,46px)/1.04 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em; color:#fff">Bezbednost i zdravlje na radu</h2>
              <p style="margin:0 0 28px; font:400 16px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.65); max-width:56ch">Preuzimamo ulogu savetnika za BZR u vašoj firmi: od akta o proceni rizika do zastupanja pred inspekcijom. Vi potpisujete akt o imenovanju, mi vodimo sistem.</p>
              <div style="display:grid; gap:0">
                {bzr.deliverables.map((item, i) => (
                  <div
                    data-fd
                    style={`display:flex; gap:14px; border-top:1px solid rgba(255,255,255,.12);${i === bzr.deliverables.length - 1 ? ' border-bottom:1px solid rgba(255,255,255,.12);' : ''} padding:15px 0; font:400 15px/1.5 "IBM Plex Sans",system-ui,sans-serif; color:rgba(255,255,255,.82)${delay(i, 6)}`}
                  ><span style="color:#FECB0F; font:700 13px 'IBM Plex Mono',monospace; padding-top:2px">{String(i + 1).padStart(2, '0')}</span>{item}</div>
                ))}
              </div>
              <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:26px; font:600 12px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.7)">
                {chips.bzr.map((chip) => (
                  <span style="border:1px solid rgba(255,255,255,.2); padding:9px 13px">{cip(chip)}</span>
                ))}
              </div>
            </div>
            <div style="flex:1 1 400px; min-width:0; align-self:flex-start; background:#FECB0F; color:#070707; padding:30px 30px 26px">
              <p style="margin:0 0 6px; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.2em; color:rgba(7,7,7,.55)">KONTROLNA LISTA</p>
              <p style="margin:0 0 18px; font:700 22px 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.02em">Dokumenta koja morate imati</p>
              <div style="display:grid; gap:0; font:500 14.5px/1.45 'IBM Plex Sans',system-ui,sans-serif">
                {bzr.checklist.map((item, i) => (
                  <div
                    data-fd
                    style={`display:flex; gap:12px; align-items:flex-start; border-top:1.5px solid rgba(7,7,7,.25);${i === bzr.checklist.length - 1 ? ' border-bottom:1.5px solid rgba(7,7,7,.25);' : ''} padding:11px 0${delay(i, 5)}`}
                  ><span style="flex:none; width:18px; height:18px; border:2px solid #070707; display:flex; align-items:center; justify-content:center; font:700 12px 'IBM Plex Sans',system-ui,sans-serif; margin-top:1px">✓</span>{item}</div>
                ))}
              </div>
              <p style="margin:16px 0 0; font:400 13px/1.5 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.6)">Ulazni audit prolazi listu tačku po tačku i kaže šta imate, šta nemate i koliko košta da se sredi.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="zop" style="background:#EFEDE6; color:#070707; padding:88px 32px 92px">
        <div style="max-width:1360px; margin:0 auto; position:relative; padding-left:44px">
          <div style="position:absolute; left:0; top:6px; bottom:6px; width:3px; background:repeating-linear-gradient(180deg,#070707 0 10px,transparent 10px 26px); animation:flowY 1.2s linear infinite" aria-hidden="true"></div>
          <p style="margin:0 0 12px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(7,7,7,.45)">USLUGA 1.2</p>
          <h2 data-wp style="margin:0 0 18px; font:700 clamp(30px,3.4vw,46px)/1.04 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em">Zaštita od požara</h2>
          <p style="margin:0 0 36px; font:400 16px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65); max-width:60ch">Referent zaštite od požara za vaš objekat: dokumentacija po kategoriji ugroženosti, obuka zaposlenih i redovna revizija aparata.</p>
          <div style="display:flex; flex-wrap:wrap; gap:40px">
            <div style="flex:1 1 460px; min-width:0">
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr)); gap:14px">
                {zop.categories.map((c, i) => (
                  <div data-fd style={`background:#fff; border:1px solid rgba(7,7,7,.18); padding:18px${delay(i, 7)}`}>
                    <p style="margin:0; font:600 10px 'IBM Plex Mono',monospace; letter-spacing:.16em; color:rgba(7,7,7,.45)">{c.kicker}</p>
                    <p style="margin:8px 0 4px; font:700 16px 'IBM Plex Sans',system-ui,sans-serif">{c.title}</p>
                    <p style="margin:0; font:400 13.5px/1.5 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.6)">{c.text}</p>
                  </div>
                ))}
              </div>
              <p style="margin:16px 0 0; font:400 13.5px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.55); max-width:64ch">Kategoriju vašeg objekta određuje MUP rešenjem. Pogledamo rešenje i odmah znate koja dokumenta su obavezna: to proveravamo besplatno, uz ulazni audit.</p>
              <div style="display:grid; gap:0; margin-top:26px; font:400 15px/1.5 'IBM Plex Sans',system-ui,sans-serif">
                {zop.prices.map((row, i) => (
                  <div
                    data-fd
                    style={`border-top:1px solid rgba(7,7,7,.2);${i === zop.prices.length - 1 ? ' border-bottom:1px solid rgba(7,7,7,.2);' : ''} padding:13px 0; display:flex; justify-content:space-between; gap:20px${delay(i, 6)}`}
                  ><span>{row.label}</span><strong style="white-space:nowrap">{iznosReda(row)}</strong></div>
                ))}
              </div>
            </div>
            <div data-fd style="flex:0 1 340px; min-width:0; align-self:flex-start; background:#070707; color:#F2F1EC; padding:28px 28px 26px; transition-delay:.1s">
              <p style="margin:0; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.2em; color:#FECB0F">NAJLAKŠI PRVI POSAO</p>
              <p style="margin:12px 0 8px; font:700 34px 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.02em">{cena('revizija-pp-aparata').iznos} <span style="font:500 13px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.5)">RSD / APARATU</span></p>
              <p style="margin:0 0 18px; font:400 14.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.7)">Revizija PP aparata na vašoj adresi, sa nalepnicom i zapisnikom. Pozovite, dolazimo: pa se upoznajemo na poslu, ne na sastanku.</p>
              <a href="/kontakt" class="btn-y" style="display:inline-block; background:#FECB0F; color:#070707; font:700 13.5px 'IBM Plex Sans',system-ui,sans-serif; padding:12px 20px">Zakažite reviziju →</a>
            </div>
          </div>
        </div>
      </section>

      <section id="koordinator" style="background:#070707; padding:88px 32px 92px">
        <div style="max-width:1360px; margin:0 auto; position:relative; padding-left:44px">
          <div style="position:absolute; left:0; top:6px; bottom:6px; width:3px; background:repeating-linear-gradient(180deg,#FECB0F 0 10px,transparent 10px 26px); animation:flowY 1.2s linear infinite" aria-hidden="true"></div>
          <p style="margin:0 0 12px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(254,203,15,.7)">USLUGA 1.3</p>
          <h2 data-wp style="margin:0 0 18px; font:700 clamp(30px,3.4vw,46px)/1.04 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em; color:#fff">Koordinator za BZR na gradilištu</h2>
          <p style="margin:0 0 14px; font:400 16px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.65); max-width:60ch">Dve lične licence, za obe faze: izradu projekta i izvođenje radova. Tri godine ovog posla na gradilištima u Slovačkoj, sada za investitore u Vojvodini.</p>
          <div style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:36px">
            {koordinator.licences.map((l) => (
              <span style="border:1px solid rgba(254,203,15,.4); color:#FECB0F; font:600 11.5px 'IBM Plex Mono',monospace; letter-spacing:.1em; padding:9px 13px">{l}</span>
            ))}
          </div>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(250px,100%),1fr)); gap:16px">
            {koordinator.cards.map((c, i) => (
              <div data-fd style={`border:1px solid rgba(255,255,255,.14); padding:22px${delay(i, 7)}`}>
                <p style="margin:0; font:700 26px 'IBM Plex Mono',monospace; color:#FECB0F">{c.metric}</p>
                <p style="margin:10px 0 6px; font:700 16px 'IBM Plex Sans',system-ui,sans-serif; color:#fff">{c.title}</p>
                <p style="margin:0; font:400 14px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.6)">{c.text}</p>
              </div>
            ))}
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:26px; font:600 12px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.7)">
            {chips.koordinator.map((chip) => (
              <span style="border:1px solid rgba(255,255,255,.2); padding:9px 13px">{cip(chip)}</span>
            ))}
          </div>
        </div>
      </section>

      <section id="obuke" style="background:#EFEDE6; color:#070707; padding:88px 32px 92px">
        <div style="max-width:1360px; margin:0 auto; position:relative; padding-left:44px">
          <div style="position:absolute; left:0; top:6px; bottom:6px; width:3px; background:repeating-linear-gradient(180deg,#070707 0 10px,transparent 10px 26px); animation:flowY 1.2s linear infinite" aria-hidden="true"></div>
          <p style="margin:0 0 12px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(7,7,7,.45)">USLUGA 1.4</p>
          <h2 data-wp style="margin:0 0 18px; font:700 clamp(30px,3.4vw,46px)/1.04 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em">Obuka i testiranje zaposlenih</h2>
          <p style="margin:0 0 36px; font:400 16px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65); max-width:60ch">Teorijski deo uživo ili onlajn, praktični deo na radnom mestu, test i evidencija na propisanom obrascu. Rokove za obnavljanje obuka pratimo mi.</p>
          <div style="display:flex; flex-wrap:wrap; gap:24px; margin-bottom:40px">
            {obuke.tiers.map((t, i) => (
              <div
                data-fd
                style={
                  t.dark
                    ? `flex:1 1 300px; background:#070707; color:#F2F1EC; padding:26px${delay(i, 8)}`
                    : `flex:1 1 300px; background:#fff; border:1px solid rgba(7,7,7,.18); padding:26px${delay(i, 8)}`
                }
              >
                <p style={t.dark ? 'margin:0; font:700 34px "IBM Plex Sans",system-ui,sans-serif; letter-spacing:-.02em; color:#FECB0F' : 'margin:0; font:700 34px "IBM Plex Sans",system-ui,sans-serif; letter-spacing:-.02em'}>{cena(t.ref).iznos} <span style={t.dark ? "font:500 13px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.5)" : "font:500 13px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.5)"}>{t.unit}</span></p>
                <p style={t.dark ? 'margin:12px 0 0; font:400 15px/1.6 "IBM Plex Sans",system-ui,sans-serif; color:rgba(255,255,255,.75)' : 'margin:12px 0 0; font:400 15px/1.6 "IBM Plex Sans",system-ui,sans-serif; color:rgba(7,7,7,.7)'}>{t.text}</p>
              </div>
            ))}
          </div>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr)); gap:0; border-top:1px solid rgba(7,7,7,.2)">
            {obuke.steps.map((s, i) => (
              <div data-fd style={`padding:20px 24px 0 0${delay(i, 6)}`}>
                <p style={s.highlight ? "margin:0; font:700 22px 'IBM Plex Mono',monospace; color:#FECB0F; -webkit-text-stroke:1px #070707" : "margin:0; font:700 22px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.25)"}>{s.n}</p>
                <p style="margin:8px 0 4px; font:700 16px 'IBM Plex Sans',system-ui,sans-serif">{s.title}</p>
                <p style="margin:0; font:400 13.5px/1.5 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.6)">{s.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section data-parallax="pre" data-pull style="position:relative; z-index:1; will-change:transform; background:#FECB0F; color:#070707; padding:72px 32px">
        <div style="max-width:1360px; margin:0 auto; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:28px">
          <div>
            <p data-wp style="margin:0; font:700 clamp(26px,3vw,40px)/1.1 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em; max-width:26ch">Ne znate šta vam od ovoga treba?</p>
            <p style="margin:10px 0 0; font:400 16px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.7)">Ulazni audit kaže tačno: šta imate, šta fali i koliko košta. Bez obaveze.</p>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:12px">
            <a href="/kontakt" class="btn-dark" style="background:#070707; color:#FECB0F; font:700 15px 'IBM Plex Sans',system-ui,sans-serif; padding:16px 28px">Zatražite ponudu</a>
            <a href="tel:+381638185587" class="btn-outline" style="border:2px solid #070707; color:#070707; font:600 14.5px 'IBM Plex Mono',monospace; padding:14px 24px">063 81 855 87</a>
          </div>
        </div>
      </section>

      <Footer serviceHref="" lastLink={{ href: '/cenovnik', label: 'Cenovnik 2026/27' }} />
    </div>

    <script>
      // Odbrojavanje do 1. januara 2027.
      const target = Date.parse('2027-01-01T00:00:00+01:00');
      const tick = () => {
        const days = String(Math.max(0, Math.floor((target - Date.now()) / 864e5)));
        document.querySelectorAll<HTMLElement>('[data-cd="days"]').forEach((el) => {
          if (el.textContent !== days) el.textContent = days;
        });
      };
      tick();
      setInterval(tick, 60000);

      // Wipe za naslove, fade za liste.
      const wipe = document.querySelectorAll<HTMLElement>('[data-wp]');
      const fade = document.querySelectorAll<HTMLElement>('[data-fd]');
      if ('IntersectionObserver' in window) {
        const reveal = (cls: string, threshold: number) =>
          new IntersectionObserver(
            (entries, obs) =>
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  e.target.classList.add(cls);
                  obs.unobserve(e.target);
                }
              }),
            { threshold }
          );
        // clip-path spušta intersectionRatio na 0, pa [data-wp] mora ići na prag 0.
        const wipeIo = reveal('wp-on', 0);
        const fadeIo = reveal('fd-on', 0.1);
        wipe.forEach((el) => wipeIo.observe(el));
        fade.forEach((el) => fadeIo.observe(el));
      } else {
        wipe.forEach((el) => el.classList.add('wp-on'));
        fade.forEach((el) => el.classList.add('fd-on'));
      }
    </script>
  </body>
</html>
