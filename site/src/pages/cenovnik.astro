---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import cenovnik from '../data/cenovnik.json';
import '../styles/responsive.css';

const { groups, note, estimator } = cenovnik;
const { defaults, limits, rates, labels, pausalOpts, checkboxes } = estimator;

const fmt = (n: number) => new Intl.NumberFormat('sr-RS').format(n);

// Ista računica kao u klijentskoj skripti, za prvi prikaz bez JS-a.
function estimate(s: typeof defaults) {
  const rows = [
    { k: labels.akt + s.mesta, v: fmt(s.mesta * rates.aktPoMestu) },
    { k: labels.pravilnikBzr, v: fmt(rates.pravilnikBzr) },
  ];
  let oneOff = s.mesta * rates.aktPoMestu + rates.pravilnikBzr;
  if (s.lzo) {
    rows.push({ k: labels.pravilnikLzo, v: fmt(rates.pravilnikLzo) });
    oneOff += rates.pravilnikLzo;
  }
  if (s.zop) {
    rows.push({ k: labels.pravilaZop, v: fmt(rates.pravilaZop) });
    oneOff += rates.pravilaZop;
  }
  if (s.obuke) {
    rows.push({ k: labels.obukaPrefix + s.zaposleni + labels.obukaSuffix, v: fmt(s.zaposleni * rates.obukaPoRadniku) });
    oneOff += s.zaposleni * rates.obukaPoRadniku;
  }
  const monthly =
    s.pausal === 'ne'
      ? labels.bezPausala
      : 'od ' + fmt(s.pausal === 'osnovni' ? rates.pausalOsnovni : rates.pausalPro) + ' RSD';
  return { rows, oneOff: fmt(oneOff), monthly };
}

const initial = estimate(defaults);

// Naslovni blok: brojevi se izvode iz podataka, ne kucaju se rucno.
const meta = {
  izdanje: '2026/27',
  grupa: String(groups.length).padStart(2, '0'),
  stavki: String(groups.reduce((n, g) => n + g.stavke.length, 0)).padStart(2, '0'),
  valuta: 'RSD',
  pdv: 'BEZ PDV-a',
};

const title = 'Cenovnik 2026/27 · Preving Pro';
const description =
  'Objavljeni cenovnik za BZR, zaštitu od požara, koordinaciju gradilišta i obuke. Cene su u dinarima, bez PDV-a, sa procenom troška za vašu firmu.';
---

<!doctype html>
<html lang="sr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
    />
    <style is:global>
      html{scroll-behavior:smooth}
      body{margin:0;background:#EFEDE6;font-family:'IBM Plex Sans',system-ui,sans-serif;color:#070707;-webkit-font-smoothing:antialiased;text-wrap:pretty}
      a{color:#070707;text-decoration:none}
      a:hover{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px}
      ::selection{background:#070707;color:#FECB0F}
      @keyframes blink{0%,45%{opacity:1}50%,95%{opacity:.12}100%{opacity:1}}
      [data-fd]{opacity:0;transform:translateY(14px);transition:opacity .5s ease,transform .5s ease}
      .fd-on{opacity:1 !important;transform:none !important}
      tr.pr:hover td, tr.pr:hover th{background:#FECB0F !important}
      input[type=range]{accent-color:#FECB0F}
      input[type=checkbox]{accent-color:#FECB0F}
      @media (prefers-reduced-motion:reduce){[data-fd]{opacity:1;transform:none;transition:none}}

      /* !important je obavezan: osnovne boje su u inline style atributima,
         koji inače pobeđuju svako pravilo iz stilova. */
      .crumb-a:hover{color:#FECB0F !important;text-decoration:none !important}
      .btn-y:hover{background:#fff !important;text-decoration:none !important}
      .btn-dark:hover{background:#1c1c1c !important;text-decoration:none !important}
      .est-row{display:flex;justify-content:space-between;gap:18px;font:400 14px 'IBM Plex Mono',monospace;color:rgba(255,255,255,.72);border-bottom:1px dotted rgba(255,255,255,.22);padding:7px 0}
      .est-row span+span{white-space:nowrap}
      .pausal-opt{border:1px solid rgba(255,255,255,.3);background:transparent;color:rgba(255,255,255,.8);font:600 13px 'IBM Plex Sans',system-ui,sans-serif;padding:11px 18px;min-height:44px;cursor:pointer}
      .pausal-opt[aria-pressed="true"]{border-color:#FECB0F;background:#FECB0F;color:#070707}

      /* Cena ima white-space:nowrap, a cirilica je sira od latinice
         ("2.000 / раднику"), pa na uskom ekranu celije dobijaju manji razmak. */
      @media (max-width:420px){
        tr.pr th, tr.pr td{padding-left:10px !important;padding-right:10px !important}
        tr.pr td{font-size:13.5px !important}
      }

      /* ---- Mehanicki brojac: cifre se kotrljaju kao na meracu protoka ---- */
      .odo{display:inline-flex;align-items:baseline;line-height:1}
      .odo-d{display:inline-block;width:1ch;height:1em;overflow:hidden;line-height:1;vertical-align:baseline}
      .odo-strip{display:block;transition:transform .55s cubic-bezier(.2,.85,.25,1)}
      .odo-strip span{display:block;height:1em;line-height:1;text-align:center}
      .odo-sep{display:inline-block}
      @media (prefers-reduced-motion:reduce){.odo-strip{transition:none}}

      /* ---- Tabele kao list specifikacije ---- */
      .sheet{border:1px solid rgba(7,7,7,.16);background:#fff;box-shadow:0 1px 0 rgba(7,7,7,.04)}
      .sheet-head{display:flex;justify-content:space-between;align-items:center;background:#070707;color:#FECB0F;padding:11px 16px;font:600 12px 'IBM Plex Mono',monospace;letter-spacing:.18em}
      .sheet-head b{color:rgba(255,255,255,.45);font-weight:600}
      .pr-idx{width:1%;white-space:nowrap;text-align:right;font:600 11px 'IBM Plex Mono',monospace;color:rgba(7,7,7,.32);padding:13px 0 13px 16px;border-bottom:1px solid rgba(7,7,7,.09);vertical-align:top}
      tr.pr:last-child th,tr.pr:last-child td{border-bottom:none}
      /* Plava mreza iza tabela: isti motiv kao sekcija Rokovi na pocetnoj. */
      .grid-bg{background-image:linear-gradient(rgba(7,7,7,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(7,7,7,.055) 1px,transparent 1px);background-size:56px 56px}

      /* ---- Naslovni blok, kao zaglavlje tehnickog crteza ---- */
      .titleblock{display:flex;flex-wrap:wrap;border:1px solid rgba(255,255,255,.18);margin-top:34px}
      .titleblock div{flex:1 1 150px;padding:11px 16px;border-right:1px solid rgba(255,255,255,.18)}
      .titleblock div:last-child{border-right:none}
      .titleblock dt{margin:0;font:600 9.5px 'IBM Plex Mono',monospace;letter-spacing:.2em;color:rgba(255,255,255,.42)}
      .titleblock dd{margin:5px 0 0;font:600 13px 'IBM Plex Mono',monospace;color:#FECB0F;font-variant-numeric:tabular-nums}
      @media (max-width:560px){.titleblock div{flex:1 1 50%;border-bottom:1px solid rgba(255,255,255,.18)}}
    </style>
  </head>
  <body>
    <div id="pg-cenovnik">
      <Header variant="inner" active="/cenovnik" />

      <section data-parallax="hero" style="background:#070707; color:#F2F1EC; padding:80px 32px 72px; position:relative; z-index:0; will-change:transform">
        <div style="max-width:1360px; margin:0 auto">
          <p style="margin:0 0 20px; font:500 11.5px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.45); letter-spacing:.2em"><a href="/" class="crumb-a" style="color:rgba(255,255,255,.45)">POČETNA</a> / <span style="color:#FECB0F">CENOVNIK 2026/27</span></p>
          <h1 style="margin:0; font:700 clamp(38px,4.6vw,68px)/1 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.035em; color:#fff">Cene bez iznenađenja.</h1>
          <p style="margin:22px 0 0; font:400 17px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.68); max-width:58ch">Objavljujemo cenovnik. U ovom poslu to gotovo niko ne radi, a mi mislimo da je to prvi test poverenja. Cene su u dinarima, bez PDV-a, informativne: tačna ponuda stiže u roku od jednog radnog dana.</p>

          <dl class="titleblock">
            <div><dt>IZDANJE</dt><dd>{meta.izdanje}</dd></div>
            <div><dt>GRUPA</dt><dd>{meta.grupa}</dd></div>
            <div><dt>STAVKI</dt><dd>{meta.stavki}</dd></div>
            <div><dt>VALUTA</dt><dd>{meta.valuta}</dd></div>
            <div><dt>PDV</dt><dd>{meta.pdv}</dd></div>
          </dl>
        </div>
      </section>

      <section style="background:#EFEDE6; padding:0 32px; position:relative; z-index:2; box-shadow:0 -30px 60px rgba(0,0,0,.55)">
        <div style="max-width:1360px; margin:-1px auto 0; box-sizing:border-box; background:#070707; color:#F2F1EC; transform:translateY(0); padding:38px 38px 34px; display:flex; flex-wrap:wrap; gap:44px; box-shadow:0 30px 60px rgba(7,7,7,.18)">
          <div style="flex:1 1 440px; min-width:0">
            <p style="margin:0 0 4px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:#FECB0F">PROCENA / INTERAKTIVNO</p>
            <p style="margin:0 0 26px; font:700 26px 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.02em; color:#fff">Koliko bi otprilike koštalo baš vama</p>
            <div style="display:grid; gap:22px">
              <label style="display:grid; gap:10px">
                <span style="display:flex; justify-content:space-between; font:600 11.5px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(255,255,255,.6)">BROJ RADNIH MESTA<span id="out-mesta" style="color:#FECB0F; font-size:14px">{defaults.mesta}</span></span>
                <input type="range" id="in-mesta" min={limits.mestaMin} max={limits.mestaMax} value={defaults.mesta} style="width:100%; cursor:pointer" />
              </label>
              <label style="display:grid; gap:10px">
                <span style="display:flex; justify-content:space-between; font:600 11.5px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(255,255,255,.6)">BROJ ZAPOSLENIH<span id="out-zaposleni" style="color:#FECB0F; font-size:14px">{defaults.zaposleni}</span></span>
                <input type="range" id="in-zaposleni" min={limits.zaposleniMin} max={limits.zaposleniMax} value={defaults.zaposleni} style="width:100%; cursor:pointer" />
              </label>
              <div style="display:grid; gap:12px; border-top:1px solid rgba(255,255,255,.14); padding-top:20px">
                {checkboxes.map((c) => (
                  <label style="display:flex; gap:12px; align-items:center; font:400 14.5px 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.85); cursor:pointer"><input type="checkbox" data-opt={c.id} checked={defaults[c.id as 'lzo' | 'zop' | 'obuke'] as boolean} style="width:17px; height:17px" />{c.label}</label>
                ))}
              </div>
              <div>
                <p style="margin:0 0 10px; font:600 11.5px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(255,255,255,.6)">MESEČNI PAUŠAL</p>
                <div style="display:flex">
                  {pausalOpts.map((p, i) => (
                    <button
                      type="button"
                      class="pausal-opt"
                      data-pausal={p.id}
                      aria-pressed={p.id === defaults.pausal ? 'true' : 'false'}
                      style={i < pausalOpts.length - 1 ? 'border-right-width:0' : 'border-right-width:1px'}
                    >{p.t}</button>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <div style="flex:1 1 380px; min-width:0; border-left:1px solid rgba(255,255,255,.14); padding-left:44px; display:flex; flex-direction:column">
            <p style="margin:0 0 18px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(255,255,255,.5)">VAŠA PROCENA</p>
            <div id="est-rows" style="display:grid; gap:6px">
              {initial.rows.map((r) => (
                <div class="est-row"><span>{r.k}</span><span>{r.v}</span></div>
              ))}
            </div>
            <div style="margin-top:auto; padding-top:24px">
              <p style="margin:0; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.18em; color:rgba(255,255,255,.5)">JEDNOKRATNO, UVOĐENJE U SISTEM</p>
              <p style="margin:6px 0 16px; font:700 clamp(30px,3vw,44px) 'IBM Plex Mono',monospace; color:#FECB0F; font-variant-numeric:tabular-nums; letter-spacing:-.01em">od <span class="odo" id="est-oneoff" data-no-cyr>{initial.oneOff}</span> <span style="font:500 14px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.5)">RSD</span></p>
              <p style="margin:0; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.18em; color:rgba(255,255,255,.5)">ZATIM MESEČNO</p>
              <p id="est-monthly" style="margin:6px 0 0; font:700 clamp(24px,2.2vw,32px) 'IBM Plex Mono',monospace; color:#fff; font-variant-numeric:tabular-nums">{initial.monthly}</p>
              <p style="margin:18px 0 0; font:400 12.5px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.45)">Informativna procena po važećem cenovniku. Tačna cena zavisi od delatnosti i stanja dokumentacije.</p>
              <a href="/kontakt" class="btn-y" style="display:inline-block; margin-top:16px; background:#FECB0F; color:#070707; font:700 14px 'IBM Plex Sans',system-ui,sans-serif; padding:13px 22px">Pretvorite u ponudu →</a>
            </div>
          </div>
        </div>
      </section>

      <section class="grid-bg" style="padding:88px 32px 40px; position:relative">
        <div style="max-width:1080px; margin:0 auto">
          {groups.map((g) => (
            <div data-fd class="sheet" style="margin-bottom:36px">
              <div class="sheet-head"><span>{g.naziv}</span><b>{g.oznaka}</b></div>
              <table style="width:100%; border-collapse:collapse">
                <tbody>
                  {g.stavke.map((r, i) => (
                    <tr class="pr">
                      <td class="pr-idx">{String(i + 1).padStart(2, '0')}</td>
                      <th scope="row" style="text-align:left; font:400 15px 'IBM Plex Sans',system-ui,sans-serif; padding:13px 16px; border-bottom:1px solid rgba(7,7,7,.09)">{r.n}<span style="display:block; font:400 12.5px 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.5); margin-top:2px">{r.d}</span></th>
                      <td style="text-align:right; font:700 15px 'IBM Plex Mono',monospace; padding:13px 16px; border-bottom:1px solid rgba(7,7,7,.09); white-space:nowrap; font-variant-numeric:tabular-nums">{r.c}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
          <p style="margin:0; font:400 13px/1.6 'IBM Plex Mono',monospace; color:rgba(7,7,7,.5)">{note}</p>
        </div>
      </section>

      <section data-parallax="pre" style="padding:40px 32px 96px; position:relative; z-index:1; will-change:transform; background:#EFEDE6">
        <div style="max-width:1080px; margin:0 auto; box-sizing:border-box; background:#FECB0F; padding:34px 34px 30px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:24px">
          <div>
            <p style="margin:0; font:700 clamp(22px,2.4vw,30px)/1.15 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.02em">Pošaljite matični broj firme i broj zaposlenih.</p>
            <p style="margin:8px 0 0; font:400 15px/1.5 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.7)">Konkretna ponuda stiže isti radni dan, sa tačnim cenama umesto „od".</p>
          </div>
          <a href="/kontakt" class="btn-dark" style="background:#070707; color:#FECB0F; font:700 15px 'IBM Plex Sans',system-ui,sans-serif; padding:16px 28px; flex:none">Zatražite ponudu</a>
        </div>
      </section>

      <Footer serviceHref="/usluge" lastLink={null} />
    </div>

    <script type="application/json" id="pp-estimator" set:html={JSON.stringify(estimator)} is:inline></script>

    <script>
      type Estimator = {
        defaults: { mesta: number; zaposleni: number; lzo: boolean; zop: boolean; obuke: boolean; pausal: string };
        rates: Record<string, number>;
        labels: Record<string, string>;
      };

      const cfg: Estimator = JSON.parse(document.getElementById('pp-estimator')?.textContent || '{}');
      const state = { ...cfg.defaults };
      const fmt = (n: number) => new Intl.NumberFormat('sr-RS').format(n);

      const rowsBox = document.getElementById('est-rows');
      const oneOffBox = document.getElementById('est-oneoff');

      // Mehanicki brojac: svaka cifra je kolona 0-9 koja se pomera na svoju
      // vrednost, pa se ukupan iznos "prevrne" kao na meracu.
      const odoShape = (t: string) => [...t].map((c) => (/\d/.test(c) ? 'd' : c)).join('');
      let odoLast = '';
      const setOdometer = (el: HTMLElement, text: string) => {
        const shape = odoShape(text);
        if (shape !== odoLast) {
          odoLast = shape;
          el.textContent = '';
          for (const ch of text) {
            if (/\d/.test(ch)) {
              const col = document.createElement('span');
              col.className = 'odo-d';
              const strip = document.createElement('span');
              strip.className = 'odo-strip';
              for (let i = 0; i < 10; i++) {
                const d = document.createElement('span');
                d.textContent = String(i);
                strip.appendChild(d);
              }
              col.appendChild(strip);
              el.appendChild(col);
            } else {
              const sep = document.createElement('span');
              sep.className = 'odo-sep';
              sep.textContent = ch;
              el.appendChild(sep);
            }
          }
        }
        [...text].forEach((ch, i) => {
          const node = el.children[i] as HTMLElement | undefined;
          if (!node) return;
          if (/\d/.test(ch)) {
            const strip = node.firstElementChild as HTMLElement | null;
            if (strip) strip.style.transform = `translateY(-${ch}em)`;
          } else {
            node.textContent = ch;
          }
        });
      };
      const monthlyBox = document.getElementById('est-monthly');

      const makeRow = (k: string, v: string) => {
        const el = document.createElement('div');
        el.className = 'est-row';
        const key = document.createElement('span');
        key.textContent = k;
        const val = document.createElement('span');
        val.textContent = v;
        el.append(key, val);
        return el;
      };

      const render = () => {
        const { rates, labels } = cfg;
        const rows: [string, string][] = [
          [labels.akt + state.mesta, fmt(state.mesta * rates.aktPoMestu)],
          [labels.pravilnikBzr, fmt(rates.pravilnikBzr)],
        ];
        let oneOff = state.mesta * rates.aktPoMestu + rates.pravilnikBzr;
        if (state.lzo) {
          rows.push([labels.pravilnikLzo, fmt(rates.pravilnikLzo)]);
          oneOff += rates.pravilnikLzo;
        }
        if (state.zop) {
          rows.push([labels.pravilaZop, fmt(rates.pravilaZop)]);
          oneOff += rates.pravilaZop;
        }
        if (state.obuke) {
          rows.push([labels.obukaPrefix + state.zaposleni + labels.obukaSuffix, fmt(state.zaposleni * rates.obukaPoRadniku)]);
          oneOff += state.zaposleni * rates.obukaPoRadniku;
        }
        if (rowsBox) rowsBox.replaceChildren(...rows.map(([k, v]) => makeRow(k, v)));
        if (oneOffBox) setOdometer(oneOffBox, fmt(oneOff));
        if (monthlyBox) {
          monthlyBox.textContent =
            state.pausal === 'ne'
              ? labels.bezPausala
              : 'od ' + fmt(state.pausal === 'osnovni' ? rates.pausalOsnovni : rates.pausalPro) + ' RSD';
        }
      };

      const bindRange = (id: string, out: string, key: 'mesta' | 'zaposleni') => {
        const input = document.getElementById(id) as HTMLInputElement | null;
        const label = document.getElementById(out);
        input?.addEventListener('input', () => {
          state[key] = +input.value;
          if (label) label.textContent = input.value;
          render();
        });
      };
      bindRange('in-mesta', 'out-mesta', 'mesta');
      bindRange('in-zaposleni', 'out-zaposleni', 'zaposleni');

      document.querySelectorAll<HTMLInputElement>('input[data-opt]').forEach((box) => {
        box.addEventListener('change', () => {
          const key = box.dataset.opt as 'lzo' | 'zop' | 'obuke';
          state[key] = box.checked;
          render();
        });
      });

      const pausalBtns = document.querySelectorAll<HTMLButtonElement>('[data-pausal]');
      pausalBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          state.pausal = btn.dataset.pausal as string;
          pausalBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          render();
        });
      });

      // Prvi prolaz pretvara server-renderovani iznos u kolone brojaca, da
      // prva izmena vec ima od cega da se kotrlja.
      render();

      // Odbrojavanje se u mokapu računa jednom, pri učitavanju.
      const target = Date.parse('2027-01-01T00:00:00+01:00');
      const days = String(Math.max(0, Math.floor((target - Date.now()) / 864e5)));
      document.querySelectorAll<HTMLElement>('[data-cd="days"]').forEach((el) => {
        if (el.textContent !== days) el.textContent = days;
      });

      // Fade-up za grupe cenovnika.
      const fade = document.querySelectorAll<HTMLElement>('[data-fd]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries, obs) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('fd-on');
                obs.unobserve(e.target);
              }
            }),
          { threshold: 0.08 }
        );
        fade.forEach((el) => io.observe(el));
      } else {
        fade.forEach((el) => el.classList.add('fd-on'));
      }
    </script>
  </body>
</html>
