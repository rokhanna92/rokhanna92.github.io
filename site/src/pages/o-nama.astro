---
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import Footer from '../components/Footer.astro';
import onama from '../data/o-nama.json';
import { firma } from '../lib/firma';
import '../styles/responsive.css';

const { stats, timeline, tim, teren, mapa } = onama;

// ---- Mapa iskustva: gde su te godine odradjene, i gde se sada slecu ----
// Projekcija je ekvidistantna, sa ispravkom po kosinusu srednje sirine. Bez
// te ispravke bi na 48 stepeni severno razmak po duzini bio razvucen skoro
// duplo, pa bi Srednja Evropa izgledala siroko i pogresno.
const svePozicije = [...mapa.tacke, mapa.cilj];
const lonMin = Math.min(...svePozicije.map((t) => t.lon));
const lonMax = Math.max(...svePozicije.map((t) => t.lon));
const latMin = Math.min(...svePozicije.map((t) => t.lat));
const latMax = Math.max(...svePozicije.map((t) => t.lat));
const kosSirine = Math.cos((((latMin + latMax) / 2) * Math.PI) / 180);

// Crtez: samo polje sa tackama i malo vazduha. Imena ne stoje na mapi nego u
// legendi pored: tri lokacije oko 48. paralele su medjusobno na svega devet
// piksela, pa bi im se natpisi preklopili i mapa bi bila necitljiva.
const POLJE_H = 260;
const POLJE_W = Math.round(POLJE_H * (((lonMax - lonMin) * kosSirine) / (latMax - latMin)));
const PAD = 20;
const PAD_GORE = 26; // mesto za broj iznad prve tacke
const VB_W = POLJE_W + PAD * 2;
const VB_H = POLJE_H + PAD_GORE + PAD;

// Uvlacenje: krajnje tacke (Unipetrol gore levo, Novi Sad dole desno) inace
// sednu tacno na okvir polja i znak im se preseca sa linijom okvira.
const UVUCI = 0.08;
const naCrtez = (t: { lon: number; lat: number }) => ({
  x: PAD + POLJE_W * (UVUCI + ((t.lon - lonMin) / (lonMax - lonMin)) * (1 - 2 * UVUCI)),
  y: PAD_GORE + POLJE_H * (UVUCI + ((latMax - t.lat) / (latMax - latMin)) * (1 - 2 * UVUCI)),
});

const ciljXY = naCrtez(mapa.cilj);
const tackeXY = mapa.tacke.map((t, i) => ({
  ...t,
  ...naCrtez(t),
  broj: String(i + 1).padStart(2, '0'),
  kasnjenje: 0.25 + i * 0.12,
}));
const ciljBroj = String(mapa.tacke.length + 1).padStart(2, '0');
const kasnjenjeCilja = (0.25 + (mapa.tacke.length - 1) * 0.12 + 0.55).toFixed(2);

// Celi stepeni unutar okvira: mreza koja crtez cini kartom, a ne ukrasom.
const mrezaLon = [];
for (let d = Math.ceil(lonMin); d <= Math.floor(lonMax); d++) mrezaLon.push(naCrtez({ lon: d, lat: latMax }).x);
const mrezaLat = [];
for (let d = Math.ceil(latMin); d <= Math.floor(latMax); d++) mrezaLat.push(naCrtez({ lon: lonMin, lat: d }).y);

const title = 'O nama · Preving Pro';
const description =
  'Preving Pro je agencija za preventivni inženjering i tehničko savetovanje iz Novog Sada. Deset godina na remontima rafinerija po EU i četiri lične licence.';
---

<!doctype html>
<html lang="sr-Latn">
  <head>
    <Seo title={title} description={description} />
    <style is:global>
      html{scroll-behavior:smooth}
      body{margin:0;background:#040404;font-family:'IBM Plex Sans',system-ui,sans-serif;color:#F2F1EC;-webkit-font-smoothing:antialiased;text-wrap:pretty}
      a{color:#F2F1EC;text-decoration:none}
      a:hover{color:#FECB0F}
      ::selection{background:#FECB0F;color:#070707}
      @keyframes blink{0%,45%{opacity:1}50%,95%{opacity:.12}100%{opacity:1}}
      [data-fd]{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
      .fd-on{opacity:1 !important;transform:none !important}
      [data-st] .st-dot{background:#040404;border:2px solid rgba(255,255,255,.35);transition:background .4s,border-color .4s,box-shadow .4s}
      [data-st].st-on .st-dot{background:#FECB0F;border-color:#FECB0F;box-shadow:0 0 0 5px rgba(254,203,15,.15)}
      [data-st] .st-tag{color:rgba(255,255,255,.4);transition:color .4s}
      [data-st].st-on .st-tag{color:#FECB0F}
      @media (prefers-reduced-motion:reduce){[data-fd]{opacity:1;transform:none;transition:none}}

      /* !important je obavezan: osnovne boje su u inline style atributima,
         koji inače pobeđuju svako pravilo iz stilova. */
      .btn-dark:hover{background:#1c1c1c !important;color:#FECB0F !important}
      .btn-outline:hover{background:#070707 !important;color:#FECB0F !important}

      /* ---- Mapa iskustva u zaglavlju ---- */
      .mapa{width:clamp(380px,38vw,520px);border:1px solid rgba(254,203,15,.22);background:#070707}
      .mapa-telo{display:flex;align-items:stretch;gap:4px;padding:14px 16px}
      .mapa-svg{flex:0 0 auto;width:50%;max-width:236px}
      /* Imena stoje ovde, a ne na mapi: tri lokacije oko 48. paralele su
         medjusobno na svega devet piksela, pa bi se natpisi preklopili. */
      .mapa-legenda{flex:1 1 auto;min-width:0;list-style:none;margin:0;padding:0 0 0 14px;
        display:flex;flex-direction:column;justify-content:center;gap:2px;
        border-left:1px solid rgba(255,255,255,.09)}
      .mapa-legenda li{display:grid;grid-template-columns:auto 1fr;column-gap:9px;align-items:baseline;
        padding:5px 0;opacity:0;animation:mapaTiho .45s ease var(--k,0s) forwards}
      .mapa-legenda i{grid-row:span 2;font:600 10px 'IBM Plex Mono',monospace;font-style:normal;
        color:rgba(255,255,255,.35);letter-spacing:.06em}
      .mapa-legenda b{font:700 12px 'IBM Plex Mono',monospace;color:#fff;letter-spacing:.04em;
        overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .mapa-legenda span{font:400 9.5px 'IBM Plex Mono',monospace;color:rgba(255,255,255,.42);letter-spacing:.1em}
      .mapa-legenda-cilj{margin-top:4px;border-top:1px dotted rgba(255,255,255,.16);padding-top:8px !important}
      .mapa-legenda-cilj i,.mapa-legenda-cilj b{color:#FECB0F}
      .mapa-head,.mapa-foot{display:flex;justify-content:space-between;align-items:center;gap:14px;
        padding:10px 14px;font:600 10px 'IBM Plex Mono',monospace;letter-spacing:.18em;color:rgba(255,255,255,.45)}
      .mapa-head{border-bottom:1px solid rgba(254,203,15,.22)}
      .mapa-head b{color:#FECB0F;font-weight:600}
      .mapa-foot{border-top:1px solid rgba(254,203,15,.22);letter-spacing:.1em}
      .mapa-foot b{color:#FECB0F;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
      /* Mreža prva, tiho. */
      .mapa-mreza{opacity:0;animation:mapaTiho .7s ease .1s forwards}
      /* Svaka linija se iscrtava od svog gradilišta ka Novom Sadu. pathLength="1"
         stoji kao atribut na <line> (u CSS-u ne bi radio) i svodi dužinu na 1,
         pa isti dasharray daje isto trajanje za linije različite dužine. */
      .mapa-linije line{stroke-dasharray:1;stroke-dashoffset:1;opacity:.55;
        animation:mapaCrta .9s cubic-bezier(.4,0,.2,1) var(--k,0s) forwards}
      /* Znak i natpis stižu tačno kad linija krene iz njih. */
      .mapa-tacka{opacity:0;animation:mapaTiho .45s ease var(--k,0s) forwards}
      .mapa-cilj{opacity:0;animation:mapaTiho .5s ease var(--k,0s) forwards}
      .mapa-puls{transform-origin:center;transform-box:fill-box;
        animation:mapaPuls 2.6s ease-out var(--k,0s) infinite}
      @keyframes mapaTiho{to{opacity:1}}
      @keyframes mapaCrta{to{stroke-dashoffset:0}}
      @keyframes mapaPuls{0%{transform:scale(.55);opacity:.9}70%{transform:scale(1.5);opacity:0}100%{transform:scale(1.5);opacity:0}}

      /* Zaglavlje se lomi u jednu kolonu čim mapa počne da steže tekst. */
      @media (max-width:1000px){
        .hero-grid{grid-template-columns:minmax(0,1fr) !important;gap:44px !important}
        .mapa{width:100%;max-width:460px}
      }
      @media (prefers-reduced-motion:reduce){
        .mapa-mreza,.mapa-linije line,.mapa-tacka,.mapa-cilj,.mapa-legenda li{animation:none;opacity:1}
        .mapa-linije line{stroke-dashoffset:0}
        .mapa-puls{animation:none}
      }

      /* Mesto za fotografiju. Zamenite <img> tagom kad slika stigne. */
      .img-slot{display:block;position:relative;font:13px/1.3 'IBM Plex Sans',system-ui,sans-serif;width:100%;height:100%;aspect-ratio:3/2}
      .img-slot-frame{position:absolute;inset:0;overflow:hidden;background:rgba(127,127,127,.08)}
      .img-slot-ring{position:absolute;inset:0;pointer-events:none;border:1.5px dashed currentColor;opacity:.35}
      .img-slot-empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;padding:12px;box-sizing:border-box}
      .img-slot-empty svg{opacity:.45}
      .img-slot-cap{max-width:90%;font-weight:500;letter-spacing:.01em;opacity:.75}
    </style>
  </head>
  <body>
    <div id="pg-onama">
      <Header variant="inner" active="/o-nama" />

      <section data-parallax="hero" style="position:relative; z-index:0; will-change:transform; background:#040404; padding:88px 32px 56px">
        {/* Mrvica ide u svoj red preko obe kolone. Zato mapa desno pocinje tacno
            u visini naslova, a ne uz mrvicu: bez ovoga panel visi iznad h1 i
            zaglavlje izgleda nakrivo. Red-razmak je 0, razmak drzi margina mrvice. */}
        <div class="hero-grid" style="max-width:1360px; margin:0 auto; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,auto); gap:0 56px; align-items:start">
          <p class="hero-crumb" style="grid-column:1 / -1; margin:0 0 20px; font:500 11.5px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.45); letter-spacing:.2em"><a href="/" style="color:rgba(255,255,255,.45)">POČETNA</a> / <span style="color:#FECB0F">O NAMA</span></p>
          <div style="min-width:0">
            <h1 style="margin:0; font:700 clamp(38px,4.6vw,68px)/1 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.035em; color:#fff; max-width:16ch">Dva čoveka. Deset godina rafinerija.</h1>
            <p style="margin:22px 0 0; font:400 17px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.68); max-width:58ch">Preving Pro je agencija za preventivni inženjering i tehničko savetovanje iz Novog Sada. Iza imena stoje dvoje ljudi i deset godina rada na projektima gde se bezbednost ne dokazuje pečatom, nego praksom.</p>
            <div style="display:flex; flex-wrap:wrap; gap:0; margin-top:40px; border-top:1px solid rgba(255,255,255,.14); max-width:760px">
              {stats.map((s, i) => (
                <div style={`display:flex; justify-content:space-between; gap:20px; width:100%;${i === stats.length - 1 ? '' : ' border-bottom:1px dotted rgba(255,255,255,.2);'} padding:11px 0; font:500 14px 'IBM Plex Mono',monospace`}><span style="color:rgba(255,255,255,.55)">{s.label}</span><span style="color:#FECB0F">{s.value}</span></div>
              ))}
            </div>
          </div>

          {/* Mapa iskustva: svaka linija je jedno gradiliste koje se slilo u
              Novi Sad. Ovo je jedina takva slika na sajtu, pa se pocetna i
              ova strana ne ponavljaju. Sve je inline SVG, bez ijedne skripte. */}
          <figure class="mapa" style="margin:0; min-width:0">
            <div class="mapa-head">
              <span>{mapa.oznaka}</span>
              <b>{String(mapa.tacke.length + 1).padStart(2, '0')} LOKACIJA</b>
            </div>
            <div class="mapa-telo">
              {/* Crtez je sakriven za citace ekrana: legenda odmah pored nosi
                  ista imena kao pravi tekst, pa bi opis mape samo udvostrucio
                  citanje. Geografski raspored je dodatak, ne nosi podatak. */}
              <svg class="mapa-svg" viewBox={`0 0 ${VB_W} ${VB_H}`} aria-hidden="true">
                <g class="mapa-mreza">
                  <g stroke="rgba(255,255,255,.10)" stroke-width="1">
                    {mrezaLon.map((x) => <line x1={x} y1={PAD_GORE} x2={x} y2={PAD_GORE + POLJE_H} />)}
                    {mrezaLat.map((y) => <line x1={PAD} y1={y} x2={PAD + POLJE_W} y2={y} />)}
                  </g>
                  {/* Okvir polja: bez njega mreza lebdi i crtez ne izgleda kao karta. */}
                  <rect x={PAD} y={PAD_GORE} width={POLJE_W} height={POLJE_H} fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1" />
                </g>

                {/* Linije ka Novom Sadu: svaka se iscrta u svom trenutku. */}
                <g class="mapa-linije" stroke="#FECB0F" stroke-width="1.1" fill="none">
                  {tackeXY.map((t) => (
                    <line x1={t.x} y1={t.y} x2={ciljXY.x} y2={ciljXY.y} pathLength="1" style={`--k:${t.kasnjenje}s`} />
                  ))}
                </g>

                {tackeXY.map((t) => (
                  <g class="mapa-tacka" style={`--k:${t.kasnjenje}s`}>
                    <rect x={t.x - 3.5} y={t.y - 3.5} width="7" height="7" fill="#040404" stroke="#FECB0F" stroke-width="1.5" />
                    <text x={t.x} y={t.y - 9} text-anchor="middle" fill="rgba(255,255,255,.7)" font-family="'IBM Plex Mono',monospace" font-size="11" font-weight="600">{t.broj}</text>
                  </g>
                ))}

                {/* Cilj: pun znak sa prstenom koji dise. Broj namerno ne stoji
                    ovde: tacno na tom mestu se sastaje svih sest linija, pa bi
                    se natpis izgubio. U legendi je red 07 ionako zut. */}
                <g class="mapa-cilj" style={`--k:${kasnjenjeCilja}s`}>
                  <circle class="mapa-puls" cx={ciljXY.x} cy={ciljXY.y} r="9" fill="none" stroke="#FECB0F" stroke-width="1.5" />
                  <circle cx={ciljXY.x} cy={ciljXY.y} r="5.5" fill="#FECB0F" />
                </g>
              </svg>

              <ol class="mapa-legenda">
                {tackeXY.map((t) => (
                  <li style={`--k:${t.kasnjenje}s`}><i>{t.broj}</i><b>{t.naziv}</b><span>{t.mesto}</span></li>
                ))}
                <li class="mapa-legenda-cilj" style={`--k:${kasnjenjeCilja}s`}><i>{ciljBroj}</i><b>{mapa.cilj.naziv}</b><span>{mapa.cilj.mesto}</span></li>
              </ol>
            </div>
            <figcaption class="mapa-foot">
              <span>{mapa.legenda}</span>
              <b>{mapa.cilj.lat}°N / {mapa.cilj.lon}°E</b>
            </figcaption>
          </figure>
        </div>
      </section>

      <section style="position:relative; z-index:2; box-shadow:0 -30px 60px rgba(0,0,0,.55); background:#070707; border-top:1px solid rgba(255,255,255,.09); padding:88px 32px 96px">
        <div style="max-width:1080px; margin:0 auto">
          <p style="margin:0 0 12px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(254,203,15,.7)">PUTANJA</p>
          <h2 style="margin:0 0 48px; font:700 clamp(28px,3.2vw,44px)/1.05 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em; color:#fff">Od Nitre do Temerinskog puta</h2>
          <div id="tl-wrap" style="position:relative; padding-left:26px">
            <div style="position:absolute; left:7px; top:8px; bottom:8px; width:2px; background:rgba(255,255,255,.14)" aria-hidden="true"></div>
            <div id="tl-fill" style="position:absolute; left:7px; top:8px; width:2px; height:0%; background:#FECB0F; max-height:calc(100% - 16px)" aria-hidden="true"></div>
            {timeline.map((t, i) => (
              <div data-st style={`position:relative; padding:0 0 ${i === timeline.length - 1 ? '4px' : '44px'} 26px`}>
                <span class="st-dot" style="position:absolute; left:-26px; top:5px; width:14px; height:14px; border-radius:50%; box-sizing:border-box"></span>
                <p class="st-tag" style="margin:0; font:700 12px 'IBM Plex Mono',monospace; letter-spacing:.2em">{t.tag}</p>
                <p style="margin:8px 0 6px; font:700 20px 'IBM Plex Sans',system-ui,sans-serif; color:#fff">{t.title}</p>
                <p style={`margin:0${t.chips ? ' 0 14px' : ''}; font:400 15px/1.6 "IBM Plex Sans",system-ui,sans-serif; color:rgba(255,255,255,.62); max-width:62ch`}>{t.text}</p>
                {t.chips && (
                  <div style="display:flex; flex-wrap:wrap; gap:8px; font:600 11.5px 'IBM Plex Mono',monospace">
                    {t.chips.map((c) => (
                      <span style="border:1px solid rgba(255,255,255,.25); color:rgba(255,255,255,.8); padding:7px 11px">{c}</span>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <section style="background:#EFEDE6; color:#070707; padding:88px 32px 92px">
        <div style="max-width:1360px; margin:0 auto">
          <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:44px">
            <h2 style="margin:0; font:700 clamp(30px,3.4vw,46px) 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em">Koga dobijate</h2>
            <span style="font:500 11px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.45); letter-spacing:.2em">TIM / 02</span>
          </div>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr)); gap:28px; max-width:980px">
            {tim.map((p, i) => (
              <div data-fd style={`background:#fff; border:1px solid rgba(7,7,7,.15)${i === 0 ? '' : '; transition-delay:.08s'}`}>
                <div style="width:100%; aspect-ratio:4/3; position:relative; border-bottom:2px solid #070707">
                  <div class="img-slot" role="img" aria-label={p.photo}>
                    <div class="img-slot-frame"></div>
                    <div class="img-slot-ring"></div>
                    <div class="img-slot-empty">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>
                      <div class="img-slot-cap">{p.photo}</div>
                    </div>
                  </div>
                </div>
                <div style="padding:24px 26px 26px">
                  <p style="margin:0; font:700 22px 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.01em">{p.name}</p>
                  <p style="margin:6px 0 14px; font:600 11.5px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(7,7,7,.55)">{p.role}</p>
                  <p style="margin:0; font:400 14.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.7)">{p.bio}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section style="background:#070707; padding:88px 32px 92px">
        <div style="max-width:1080px; margin:0 auto">
          <p style="margin:0 0 12px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(254,203,15,.7)">ŠTA DONOSIMO NA TEREN</p>
          <div style="display:grid; gap:0; border-top:1px solid rgba(255,255,255,.14); margin-top:26px">
            {teren.map((r, i) => (
              <div data-fd style={`display:flex; flex-wrap:wrap; gap:8px 40px;${i === teren.length - 1 ? '' : ' border-bottom:1px solid rgba(255,255,255,.14);'} padding:22px 0${i === 0 ? '' : `; transition-delay:${(i * 7) / 100}s`}`}>
                <span style="flex:0 0 220px; font:700 13px 'IBM Plex Mono',monospace; letter-spacing:.12em; color:#FECB0F">{r.label}</span>
                <span style="flex:1 1 400px; font:400 15px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.72)">{r.text}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section data-parallax="pre" data-pull style="position:relative; z-index:1; will-change:transform; background:#FECB0F; color:#070707; padding:72px 32px">
        <div style="max-width:1360px; margin:0 auto; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:28px">
          <p style="margin:0; font:700 clamp(26px,3vw,40px)/1.1 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em; max-width:30ch">Upoznajmo se na vašem terenu, ne na sastanku.</p>
          <div style="display:flex; flex-wrap:wrap; gap:12px">
            <a href="/kontakt" class="btn-dark" style="background:#070707; color:#FECB0F; font:700 15px 'IBM Plex Sans',system-ui,sans-serif; padding:16px 28px">Zatražite ponudu</a>
            <a href={firma.telefonHref} class="btn-outline" style="border:2px solid #070707; color:#070707; font:600 14.5px 'IBM Plex Mono',monospace; padding:14px 24px">{firma.telefon}</a>
          </div>
        </div>
      </section>

      <Footer serviceHref="/usluge" lastLink={{ href: '/cenovnik', label: 'Cenovnik 2026/27' }} />
    </div>

    <script>
      // Odbrojavanje, isto kao u mokapu: osvežava se jednom u minutu.
      const target = Date.parse('2027-01-01T00:00:00+01:00');
      const dayBoxes = document.querySelectorAll<HTMLElement>('[data-cd="days"]');
      const tick = () => {
        const days = String(Math.max(0, Math.floor((target - Date.now()) / 864e5)));
        dayBoxes.forEach((el) => {
          if (el.textContent !== days) el.textContent = days;
        });
      };
      tick();
      setInterval(tick, 60000);

      // Fade-up za kartice i redove.
      const fade = document.querySelectorAll<HTMLElement>('[data-fd]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries, obs) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('fd-on');
                obs.unobserve(e.target);
              }
            }),
          { threshold: 0.1 }
        );
        fade.forEach((el) => io.observe(el));
      } else {
        fade.forEach((el) => el.classList.add('fd-on'));
      }

      // Traka putanje se puni sa skrolom, stanice se pale kad je punjenje prođe.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const wrap = document.getElementById('tl-wrap');
      const fill = document.getElementById('tl-fill');
      const stations = Array.from(document.querySelectorAll<HTMLElement>('[data-st]'));

      if (wrap && fill) {
        const update = () => {
          const r = wrap.getBoundingClientRect();
          const vh = window.innerHeight || 1;
          const p = Math.min(Math.max((vh * 0.72 - r.top) / r.height, 0), 1);
          fill.style.height = (p * 100).toFixed(2) + '%';
          const fillBottom = r.top + r.height * p;
          stations.forEach((st) => {
            const sr = st.getBoundingClientRect();
            st.classList.toggle('st-on', sr.top + 10 <= fillBottom);
          });
        };

        if (reduced) {
          fill.style.height = '100%';
          stations.forEach((s) => s.classList.add('st-on'));
        } else {
          let raf = 0;
          const onScroll = () => {
            if (raf) return;
            raf = requestAnimationFrame(() => {
              raf = 0;
              update();
            });
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });
          update();
        }
      }
    </script>
  </body>
</html>
