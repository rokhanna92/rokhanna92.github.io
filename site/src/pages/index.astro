---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import services from '../data/services.json';
import prices from '../data/prices.json';
import faq from '../data/faq.json';
import formOptions from '../data/form-options.json';
import '../styles/responsive.css';

// 1. januar 2027. u 00:00 po srednjoevropskom vremenu.
const target = Date.parse('2027-01-01T00:00:00+01:00');
const left = Math.max(0, target - Date.now());
const pad = (n: number) => String(n).padStart(2, '0');
const cd = {
  days: String(Math.floor(left / 864e5)),
  hh: pad(Math.floor(left / 36e5) % 24),
  mm: pad(Math.floor(left / 6e4) % 60),
  ss: pad(Math.floor(left / 1e3) % 60),
};

const empOpts = ['Nemam zaposlene', '1–20', 'Više od 20'];
const actOpts = [
  'Građevina, proizvodnja, skladištenje, transport',
  'Kancelarija, IT, trgovina, usluge',
  'Nešto drugo',
];

const results = {
  noEmp: {
    title: 'Ne, još ne.',
    body: 'Obaveze iz Zakona o BZR nastaju sa prvim zaposlenim. Ako planirate zapošljavanje, pametno je pripremiti akt o proceni rizika i pravilnike pre prvog ugovora. Jeftinije je nego naknadno usklađivanje.',
    fine: false,
  },
  many: {
    title: 'Da, bez izuzetka.',
    body: 'Sa više od 20 zaposlenih poslodavac ne može sam da obavlja poslove BZR ni u jednoj delatnosti. Potrebno vam je stručno lice, kompletna dokumentacija i evidencije usklađene sa novim pravilnicima.',
    fine: true,
  },
  risk: {
    title: 'Da, potreban vam je.',
    body: 'Sa najmanje jednim zaposlenim u delatnosti povećanog rizika dužni ste da organizujete poslove bezbednosti i zdravlja na radu i angažujete stručno lice. Sami taj posao ne možete voditi.',
    fine: true,
  },
  office: {
    title: 'Možda, uz stručni ispit.',
    body: 'U pojedinim manje rizičnim delatnostima poslodavac sa do 20 zaposlenih može sam da obavlja poslove BZR, pod uslovom da položi stručni ispit. U praksi većina vlasnika taj posao poverava stručnom licu. Vreme, evidencije i izmene propisa ostaju naša briga.',
    fine: false,
  },
  other: {
    title: 'Verovatno da, zavisi od šifre delatnosti.',
    body: 'Lista manje rizičnih delatnosti je zatvorena. Ako vaša šifra delatnosti nije na njoj, poslove BZR mora voditi stručno lice. Pozovite nas sa matičnim brojem firme i odgovaramo odmah.',
    fine: false,
  },
};

// Polazno stanje ankete: 1–20 zaposlenih, delatnost povećanog rizika.
const empDefault = 1;
const actDefault = 0;
const initial = results.risk;

const title = 'Preving Pro · Bezbednost i zdravlje na radu i zaštita od požara';
const description =
  'Savetnik za BZR, referent zaštite od požara i koordinator gradilišta. Novi Sad, Klisa. Dokumentacija, obuke i rokovi pod kontrolom.';
---

<!doctype html>
<html lang="sr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
    />
    <style is:global>
      html{scroll-behavior:smooth}
      body{margin:0;background:#040404;font-family:'IBM Plex Sans',system-ui,sans-serif;color:#F2F1EC;-webkit-font-smoothing:antialiased;text-wrap:pretty}
      a{color:#F2F1EC;text-decoration:none}
      a:hover{color:#FECB0F}
      ::selection{background:#FECB0F;color:#070707}
      @keyframes marquee{to{transform:translateX(-50%)}}
      @keyframes blink{0%,45%{opacity:1}50%,95%{opacity:.12}100%{opacity:1}}
      summary{cursor:pointer;list-style:none}
      summary::-webkit-details-marker{display:none}
      details[open] .faq-x{transform:rotate(45deg)}
      .faq-x{transition:transform .25s}
      [data-rv]{opacity:0;transform:translateY(26px);transition:opacity .8s cubic-bezier(.2,.6,.2,1),transform .8s cubic-bezier(.2,.6,.2,1)}
      .rv-on{opacity:1 !important;transform:none !important}
      @media (prefers-reduced-motion:reduce){[data-rv]{opacity:1;transform:none;transition:none}}
      input,select,textarea{font-family:'IBM Plex Sans',system-ui,sans-serif}

      [hidden]{display:none !important}
      /* !important je obavezan: osnovne boje su u inline style atributima,
         koji inače pobeđuju svako pravilo iz stilova. */
      .btn-y:hover{background:#fff !important;color:#070707 !important}
      .btn-ghost:hover{border-color:#FECB0F !important;color:#FECB0F !important}
      .btn-dark:hover{background:#1c1c1c !important;color:#FECB0F !important}
      .btn-outline:hover{background:#070707 !important;color:#FECB0F !important}
      .keep-ink:hover{color:#070707 !important}
      .field:focus{border-color:#FECB0F !important}
      .opt{border:1px solid rgba(255,255,255,.28);background:transparent;color:rgba(255,255,255,.85);font:600 13.5px 'IBM Plex Sans',system-ui,sans-serif;padding:12px 18px;min-height:48px;cursor:pointer}
      .opt[aria-pressed="true"]{border-color:#FECB0F;background:#FECB0F;color:#070707}
      .hero-panel{display:block}
      @media (max-width:1139px){.hero-panel{display:none}}
    </style>
  </head>
  <body>
    <div id="pp-root">
      <Header />

      <section
        id="hero"
        data-parallax="hero"
        style="position:relative; z-index:0; will-change:transform; min-height:max(680px, calc(100vh - 120px)); background:#040404; overflow:hidden; display:flex; flex-direction:column"
      >
        <div style="position:absolute; inset:0">
          <refinery-scene drift="1" style="position:absolute; inset:0; width:100%; height:100%"></refinery-scene>
          <div style="position:absolute; inset:0; pointer-events:none; background:linear-gradient(90deg,rgba(4,4,4,.93) 0%,rgba(4,4,4,.72) 40%,rgba(4,4,4,.06) 72%,rgba(4,4,4,.5) 100%)"></div>
          <div style="position:absolute; left:0; right:0; bottom:0; height:240px; pointer-events:none; background:linear-gradient(180deg,transparent,rgba(4,4,4,.9))"></div>
          <div style="position:absolute; left:0; right:0; top:0; height:90px; pointer-events:none; background:linear-gradient(180deg,rgba(4,4,4,.8),transparent)"></div>
        </div>

        <div style="position:relative; display:flex; justify-content:space-between; gap:20px; flex-wrap:wrap; padding:24px 32px 0">
          <span style="font:500 11px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.42); letter-spacing:.16em; font-variant-numeric:tabular-nums">45.29°N / 19.85°E · NOVI SAD · KLISA</span>
          <span style="font:500 11px 'IBM Plex Mono',monospace; color:#FECB0F; letter-spacing:.16em; display:flex; align-items:center; gap:7px"><span style="width:6px; height:6px; border-radius:50%; background:#FECB0F; animation:blink 1.8s steps(1,end) infinite"></span>LINIJA 24/7 AKTIVNA</span>
        </div>

        <div style="position:relative; flex:1; display:flex; align-items:center; padding:40px 32px 56px">
          <div style="max-width:1360px; margin:0 auto; width:100%; display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:36px">
            <div style="max-width:680px; min-width:min(100%,420px)">
              <p style="margin:0 0 22px; font:500 11.5px 'IBM Plex Mono',monospace; color:#FECB0F; letter-spacing:.22em">BZR_01 / ZOP_02 / KOORDINATOR_03 / OBUKE_04</p>
              <h1 style="margin:0; font:700 clamp(42px,4.8vw,72px)/0.98 'IBM Plex Sans',system-ui,sans-serif; color:#fff; letter-spacing:-.035em">Bezbednost i zdravlje na radu po standardu <span style="color:#FECB0F">rafinerije</span>.</h1>
              <p style="margin:22px 0 0; font:400 17px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.7); max-width:52ch">Savetnik za BZR, referent zaštite od požara i koordinator gradilišta. Deset godina na projektima u Slovačkoj, Mađarskoj, Češkoj, Austriji i Hrvatskoj. Vi radite svoj posao, a dokumentaciju, obuke i rokove držimo mi.</p>
              <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:30px; align-items:center">
                <a href="#kontakt" class="btn-y" style="background:#FECB0F; color:#070707; font:700 14.5px 'IBM Plex Sans',system-ui,sans-serif; padding:15px 26px">Zatražite ponudu</a>
                <a href="tel:+381638185587" class="btn-ghost" style="border:1px solid rgba(255,255,255,.32); color:#fff; font:600 14px 'IBM Plex Mono',monospace; padding:14px 22px; backdrop-filter:blur(3px)">063 81 855 87</a>
                <a href="/cenovnik" style="font:600 14px 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.85); text-decoration:underline; text-decoration-thickness:1.5px; text-underline-offset:4px; margin-left:8px">Pogledajte cenovnik →</a>
              </div>
            </div>
            <div class="hero-panel" style="width:268px; border:1px solid rgba(254,203,15,.28); background:rgba(4,4,4,.66); backdrop-filter:blur(4px); padding:18px 18px 16px; flex:none">
              <div style="display:flex; justify-content:space-between; align-items:center; font:500 10px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.45); letter-spacing:.18em; padding-bottom:12px; border-bottom:1px solid rgba(255,255,255,.14)"><span>STATUS / PROPISI</span><span style="color:#FECB0F">ŽIVO</span></div>
              <div style="display:flex; justify-content:space-between; font:500 12px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.75); padding:11px 0 0"><span>Zakon 35/2023</span><span style="color:#FECB0F">NA SNAZI</span></div>
              <div style="display:flex; justify-content:space-between; font:500 12px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.75); padding:7px 0 0"><span>4 nova pravilnika</span><span style="color:#FECB0F">01.01.2027.</span></div>
              <div style="display:flex; justify-content:space-between; font:500 12px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.75); padding:7px 0 14px"><span>Lične licence</span><span style="color:#FECB0F">4 / 4</span></div>
              <div style="border-top:1px solid rgba(255,255,255,.14); padding-top:12px">
                <div style="font:700 30px 'IBM Plex Mono',monospace; color:#fff; letter-spacing:.02em; font-variant-numeric:tabular-nums"><span data-cd="days">{cd.days}</span><span style="color:rgba(255,255,255,.35)">:</span><span data-cd="hh">{cd.hh}</span><span style="color:rgba(255,255,255,.35)">:</span><span data-cd="mm">{cd.mm}</span><span style="color:rgba(255,255,255,.35)">:</span><span data-cd="ss">{cd.ss}</span></div>
                <div style="display:flex; gap:0; font:500 9px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.42); letter-spacing:.14em; margin-top:4px"><span style="width:64px">DANA</span><span style="width:48px">SATI</span><span style="width:48px">MIN</span><span>SEK</span></div>
              </div>
            </div>
          </div>
        </div>

        <div style="position:relative; height:44px; background:#FECB0F; display:flex; align-items:center; overflow:hidden; flex:none">
          <div style="display:flex; white-space:nowrap; font:600 12px 'IBM Plex Mono',monospace; color:#070707; letter-spacing:.16em; animation:marquee 28s linear infinite">
            <span style="padding-right:44px">AKT O PROCENI RIZIKA</span><span style="padding-right:44px">/ OBUKA ZAPOSLENIH</span><span style="padding-right:44px">/ PLAN EVAKUACIJE</span><span style="padding-right:44px">/ ELABORAT O UREĐENJU GRADILIŠTA</span><span style="padding-right:44px">/ REVIZIJA PP APARATA</span><span style="padding-right:44px">/ ZASTUPANJE PRED INSPEKCIJOM</span><span style="padding-right:44px">/ GEOTAGOVANI FOTOREPORTING</span>
            <span style="padding-right:44px">AKT O PROCENI RIZIKA</span><span style="padding-right:44px">/ OBUKA ZAPOSLENIH</span><span style="padding-right:44px">/ PLAN EVAKUACIJE</span><span style="padding-right:44px">/ ELABORAT O UREĐENJU GRADILIŠTA</span><span style="padding-right:44px">/ REVIZIJA PP APARATA</span><span style="padding-right:44px">/ ZASTUPANJE PRED INSPEKCIJOM</span><span style="padding-right:44px">/ GEOTAGOVANI FOTOREPORTING</span>
          </div>
        </div>
      </section>

      <section style="position:relative; z-index:2; background:#0b0b0b; border-top:1px solid rgba(255,255,255,.08); box-shadow:0 -30px 60px rgba(0,0,0,.55)">
        <div style="max-width:1360px; margin:0 auto; padding:36px 32px; display:grid; grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr)); gap:0">
          <div style="padding:0 28px 0 0"><div style="font:700 42px 'IBM Plex Sans',system-ui,sans-serif; color:#FECB0F; letter-spacing:-.03em">04</div><div style="font:400 13.5px/1.5 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.6); margin-top:8px">lične licence Inspektorata za rad i MUP-a Republike Srbije</div></div>
          <div style="padding:0 28px; border-left:1px solid rgba(255,255,255,.1)"><div style="font:700 42px 'IBM Plex Sans',system-ui,sans-serif; color:#FECB0F; letter-spacing:-.03em">10</div><div style="font:400 13.5px/1.5 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.6); margin-top:8px">godina na investicionim projektima i remontima u EU</div></div>
          <div style="padding:0 28px; border-left:1px solid rgba(255,255,255,.1)"><div style="font:700 42px 'IBM Plex Sans',system-ui,sans-serif; color:#FECB0F; letter-spacing:-.03em">05</div><div style="font:400 13.5px/1.5 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.6); margin-top:8px">rafinerija: Slovnaft, MOL, Unipetrol, OMV i INA</div></div>
          <div style="padding:0 0 0 28px; border-left:1px solid rgba(255,255,255,.1)"><div style="font:700 42px 'IBM Plex Sans',system-ui,sans-serif; color:#FECB0F; letter-spacing:-.03em">24/7</div><div style="font:400 13.5px/1.5 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.6); margin-top:8px">telefonska linija i hitan izlazak na teren</div></div>
        </div>
      </section>

      <section id="provera" style="position:relative; z-index:2; background:#070707; border-top:1px solid rgba(255,255,255,.08); padding:96px 32px 100px">
        <div style="max-width:1360px; margin:0 auto; display:flex; flex-wrap:wrap; gap:60px">
          <div style="flex:1 1 480px; min-width:0" data-rv>
            <p style="margin:0 0 14px; font:500 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(254,203,15,.7)">SISTEM / PROVERA OBAVEZA</p>
            <h2 style="margin:0 0 12px; font:700 clamp(30px,3.2vw,44px)/1.04 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em; color:#fff">Da li vam je potreban savetnik za BZR?</h2>
            <p style="margin:0 0 36px; font:400 16.5px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.62)">Odgovorite na dva pitanja i odmah znate na čemu ste.</p>
            <p style="margin:0 0 12px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.16em; color:rgba(255,255,255,.45)">01 / KOLIKO IMATE ZAPOSLENIH?</p>
            <div style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:26px">
              {empOpts.map((t, i) => (
                <button type="button" class="opt" data-q="emp" data-i={i} aria-pressed={i === empDefault ? 'true' : 'false'}>{t}</button>
              ))}
            </div>
            <p style="margin:0 0 12px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.16em; color:rgba(255,255,255,.45)">02 / ČIME SE BAVITE?</p>
            <div style="display:flex; flex-wrap:wrap; gap:10px">
              {actOpts.map((t, i) => (
                <button type="button" class="opt" data-q="act" data-i={i} aria-pressed={i === actDefault ? 'true' : 'false'} style="text-align:left">{t}</button>
              ))}
            </div>
            <p style="margin:32px 0 0; font:400 13px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.4); max-width:58ch">Informativna procena na osnovu Zakona o BZR („Sl. glasnik RS" br. 35/2023). Ne zamenjuje stručnu ocenu. Pozovite nas i proverićemo vaš konkretan slučaj.</p>
          </div>
          <div aria-live="polite" style="flex:1 1 420px; min-width:0; background:#FECB0F; color:#070707; padding:34px 34px 30px; min-height:360px; align-self:stretch; display:flex; flex-direction:column; gap:16px" data-rv>
            <p style="margin:0; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(7,7,7,.55)">REZULTAT</p>
            <p id="res-title" style="margin:0; font:700 clamp(28px,2.8vw,40px)/1.04 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.025em">{initial.title}</p>
            <p id="res-body" style="margin:0; font:400 15.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.85)">{initial.body}</p>
            <div id="res-fine" hidden={!initial.fine} style="display:flex; flex-wrap:wrap; gap:30px; border-top:1.5px solid rgba(7,7,7,.3); padding-top:16px">
              <div><p style="margin:0; font:600 10px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(7,7,7,.5)">ROK</p><p style="margin:4px 0 0; font:700 19px 'IBM Plex Sans',system-ui,sans-serif">1. januar 2027.</p></div>
              <div><p style="margin:0; font:600 10px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(7,7,7,.5)">KAZNA ZA PREDUZETNIKA</p><p style="margin:4px 0 0; font:700 19px 'IBM Plex Sans',system-ui,sans-serif">400.000–500.000 RSD</p></div>
            </div>
            <div style="margin-top:auto"><a href="#kontakt" class="btn-dark" style="display:inline-block; background:#070707; color:#FECB0F; font:700 14px 'IBM Plex Sans',system-ui,sans-serif; padding:14px 24px">Zatražite ponudu →</a></div>
          </div>
        </div>
      </section>

      <section id="usluge" style="position:relative; z-index:2; background:#EFEDE6; color:#070707; padding:96px 32px 100px">
        <div style="max-width:1360px; margin:0 auto">
          <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:44px" data-rv>
            <h2 style="margin:0; font:700 clamp(32px,3.6vw,48px) 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.035em">Šta radimo</h2>
            <span style="font:500 11px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.45); letter-spacing:.2em">01 / USLUGE</span>
          </div>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr)); gap:24px">
            {services.map((s) => (
              <a
                href={`/usluge#${s.id}`}
                class="keep-ink"
                data-rv
                style={
                  s.featured
                    ? 'display:block; border-top:3px solid #FECB0F; padding:20px 0 8px; color:#070707; background:linear-gradient(180deg,rgba(254,203,15,.22),transparent 65%)'
                    : 'display:block; border-top:3px solid #070707; padding:20px 0 8px; color:#070707'
                }
              >
                <div style="font:500 11px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.4); letter-spacing:.16em">{s.num}</div>
                <h3 style="margin:12px 0 10px; font:700 20px/1.2 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.01em">{s.title}</h3>
                <p style="margin:0; font:400 14.5px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65)">{s.text}</p>
                <div style="margin-top:16px; font:600 13px 'IBM Plex Mono',monospace">Više →</div>
              </a>
            ))}
          </div>

          <div style="border-top:1px solid rgba(7,7,7,.15); margin-top:72px; padding-top:56px; display:flex; flex-wrap:wrap; gap:56px" id="kako">
            <div style="flex:0 1 340px" data-rv>
              <p style="margin:0 0 12px; font:500 11px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.45); letter-spacing:.2em">02 / PROCEDURA</p>
              <h2 style="margin:0; font:700 clamp(28px,3vw,40px)/1.05 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em">Kako radimo</h2>
              <p style="margin:16px 0 0; font:400 15.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65)">Sve počinje ulaznim auditom, bez obaveze. Posle njega tačno znate šta vam nedostaje, koliko košta i kojim redom se rešava.</p>
            </div>
            <div style="flex:1 1 560px; min-width:0">
              <div style="display:flex; gap:24px; border-top:1px solid rgba(7,7,7,.18); padding:22px 0" data-rv>
                <span style="font:700 34px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.2); flex:none; width:64px">01</span>
                <div><h3 style="margin:0 0 6px; font:700 18px 'IBM Plex Sans',system-ui,sans-serif">Ulazni BZR audit</h3><p style="margin:0; font:400 14.5px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65)">Pregledamo dokumentaciju, radna mesta i evidencije. Dobijate spisak nedostataka i redosled rešavanja, bez obaveze da nastavite sa nama.</p></div>
              </div>
              <div style="display:flex; gap:24px; border-top:1px solid rgba(7,7,7,.18); padding:22px 0" data-rv>
                <span style="font:700 34px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.2); flex:none; width:64px">02</span>
