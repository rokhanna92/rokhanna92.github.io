---
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import Footer from '../components/Footer.astro';
import services from '../data/services.json';
import prices from '../data/prices.json';
import faq from '../data/faq.json';
import formOptions from '../data/form-options.json';
import tekst from '../data/index.json';
import { cena, labelReda } from '../lib/cene';
import { firma } from '../lib/firma';
import '../styles/responsive.css';

// 1. januar 2027. u 00:00 po srednjoevropskom vremenu.
const target = Date.parse('2027-01-01T00:00:00+01:00');
const left = Math.max(0, target - Date.now());
const pad = (n: number) => String(n).padStart(2, '0');
const cd = {
  days: String(Math.floor(left / 864e5)),
  hh: pad(Math.floor(left / 36e5) % 24),
  mm: pad(Math.floor(left / 6e4) % 60),
  ss: pad(Math.floor(left / 1e3) % 60),
};

// Sav tekst naslovne strane stoji u src/data/index.json, da urednik moze da ga
// menja kroz CMS. U kodu ostaju samo strukturne labele i prelom.
const { hero, brojke, provera, kako, rokovi, paketi, zasto, kontakt } = tekst;
const uslugeTekst = tekst.usluge;
const cenovnikTekst = tekst.cenovnik;
const faqTekst = tekst.faq;

const empOpts = provera.odgovori1;
const actOpts = provera.odgovori2;
const results = provera.rezultati;

// Polazno stanje ankete: 1–20 zaposlenih, delatnost povećanog rizika.
const empDefault = 1;
const actDefault = 0;
const initial = results.risk;

const title = tekst.meta.naslov;
const description = tekst.meta.opis;
---

<!doctype html>
<html lang="sr-Latn">
  <head>
    <Seo title={title} description={description} business />
    <style is:global>
      html{scroll-behavior:smooth}
      body{margin:0;background:#040404;font-family:'IBM Plex Sans',system-ui,sans-serif;color:#F2F1EC;-webkit-font-smoothing:antialiased;text-wrap:pretty}
      a{color:#F2F1EC;text-decoration:none}
      a:hover{color:#FECB0F}
      ::selection{background:#FECB0F;color:#070707}
      @keyframes marquee{to{transform:translateX(-50%)}}
      @keyframes blink{0%,45%{opacity:1}50%,95%{opacity:.12}100%{opacity:1}}
      summary{cursor:pointer;list-style:none}
      summary::-webkit-details-marker{display:none}
      details[open] .faq-x{transform:rotate(45deg)}
      .faq-x{transition:transform .25s}
      [data-rv]{opacity:0;transform:translateY(26px);transition:opacity .8s cubic-bezier(.2,.6,.2,1),transform .8s cubic-bezier(.2,.6,.2,1)}
      .rv-on{opacity:1 !important;transform:none !important}
      @media (prefers-reduced-motion:reduce){[data-rv]{opacity:1;transform:none;transition:none}}
      input,select,textarea{font-family:'IBM Plex Sans',system-ui,sans-serif}

      [hidden]{display:none !important}
      /* !important je obavezan: osnovne boje su u inline style atributima,
         koji inače pobeđuju svako pravilo iz stilova. */
      .btn-y:hover{background:#fff !important;color:#070707 !important}
      .btn-ghost:hover{border-color:#FECB0F !important;color:#FECB0F !important}
      .btn-dark:hover{background:#1c1c1c !important;color:#FECB0F !important}
      .btn-outline:hover{background:#070707 !important;color:#FECB0F !important}
      .keep-ink:hover{color:#070707 !important}
      .field:focus{border-color:#FECB0F !important}
      .opt{border:1px solid rgba(255,255,255,.28);background:transparent;color:rgba(255,255,255,.85);font:600 13.5px 'IBM Plex Sans',system-ui,sans-serif;padding:12px 18px;min-height:48px;cursor:pointer}
      .opt[aria-pressed="true"]{border-color:#FECB0F;background:#FECB0F;color:#070707}
      .hero-panel{display:block}
      @media (max-width:1139px){.hero-panel{display:none}}
    </style>
  </head>
  <body>
    <div id="pp-root">
      <Header />

      <section
        id="hero"
        data-parallax="hero"
        style="position:relative; z-index:0; will-change:transform; min-height:max(680px, calc(100vh - 120px)); background:#040404; overflow:hidden; display:flex; flex-direction:column"
      >
        <div style="position:absolute; inset:0">
          <refinery-scene drift="1" style="position:absolute; inset:0; width:100%; height:100%"></refinery-scene>
          <div style="position:absolute; inset:0; pointer-events:none; background:linear-gradient(90deg,rgba(4,4,4,.93) 0%,rgba(4,4,4,.72) 40%,rgba(4,4,4,.06) 72%,rgba(4,4,4,.5) 100%)"></div>
          <div style="position:absolute; left:0; right:0; bottom:0; height:240px; pointer-events:none; background:linear-gradient(180deg,transparent,rgba(4,4,4,.9))"></div>
          <div style="position:absolute; left:0; right:0; top:0; height:90px; pointer-events:none; background:linear-gradient(180deg,rgba(4,4,4,.8),transparent)"></div>
        </div>

        <div style="position:relative; display:flex; justify-content:space-between; gap:20px; flex-wrap:wrap; padding:24px 32px 0">
          <span style="font:500 11px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.42); letter-spacing:.16em; font-variant-numeric:tabular-nums">{hero.koordinate}</span>
          <span style="font:500 11px 'IBM Plex Mono',monospace; color:#FECB0F; letter-spacing:.16em; display:flex; align-items:center; gap:7px"><span style="width:6px; height:6px; border-radius:50%; background:#FECB0F; animation:blink 1.8s steps(1,end) infinite"></span>{hero.linija}</span>
        </div>

        <div style="position:relative; flex:1; display:flex; align-items:center; padding:40px 32px 56px">
          <div style="max-width:1360px; margin:0 auto; width:100%; display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:36px">
            <div style="max-width:680px; min-width:min(100%,420px)">
              <p style="margin:0 0 22px; font:500 11.5px 'IBM Plex Mono',monospace; color:#FECB0F; letter-spacing:.22em">{hero.oznaka}</p>
              <h1 style="margin:0; font:700 clamp(42px,4.8vw,72px)/0.98 'IBM Plex Sans',system-ui,sans-serif; color:#fff; letter-spacing:-.035em">{hero.naslovPre} <span style="color:#FECB0F">{hero.naslovAkcenat}</span>{hero.naslovPosle}</h1>
              <p style="margin:22px 0 0; font:400 17px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.7); max-width:52ch">{hero.uvod}</p>
              <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:30px; align-items:center">
                <a href="#kontakt" class="btn-y" style="background:#FECB0F; color:#070707; font:700 14.5px 'IBM Plex Sans',system-ui,sans-serif; padding:15px 26px">{hero.dugmePonuda}</a>
                <a href={firma.telefonHref} class="btn-ghost" style="border:1px solid rgba(255,255,255,.32); color:#fff; font:600 14px 'IBM Plex Mono',monospace; padding:14px 22px; backdrop-filter:blur(3px)">{firma.telefon}</a>
                <a href="/cenovnik" style="font:600 14px 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.85); text-decoration:underline; text-decoration-thickness:1.5px; text-underline-offset:4px; margin-left:8px">{hero.linkCenovnik}</a>
              </div>
            </div>
            <div class="hero-panel" style="width:268px; border:1px solid rgba(254,203,15,.28); background:rgba(4,4,4,.66); backdrop-filter:blur(4px); padding:18px 18px 16px; flex:none">
              <div style="display:flex; justify-content:space-between; align-items:center; font:500 10px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.45); letter-spacing:.18em; padding-bottom:12px; border-bottom:1px solid rgba(255,255,255,.14)"><span>{hero.panel.naslov}</span><span style="color:#FECB0F">{hero.panel.zivo}</span></div>
              {hero.panel.redovi.map((r, i) => (
                <div style={`display:flex; justify-content:space-between; font:500 12px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.75); padding:${i === 0 ? '11px 0 0' : i === hero.panel.redovi.length - 1 ? '7px 0 14px' : '7px 0 0'}`}><span>{r.label}</span><span style="color:#FECB0F">{r.value}</span></div>
              ))}
              <div style="border-top:1px solid rgba(255,255,255,.14); padding-top:12px">
                <div style="font:700 30px 'IBM Plex Mono',monospace; color:#fff; letter-spacing:.02em; font-variant-numeric:tabular-nums"><span data-cd="days">{cd.days}</span><span style="color:rgba(255,255,255,.35)">:</span><span data-cd="hh">{cd.hh}</span><span style="color:rgba(255,255,255,.35)">:</span><span data-cd="mm">{cd.mm}</span><span style="color:rgba(255,255,255,.35)">:</span><span data-cd="ss">{cd.ss}</span></div>
                <div style="display:flex; gap:0; font:500 9px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.42); letter-spacing:.14em; margin-top:4px"><span style="width:64px">DANA</span><span style="width:48px">SATI</span><span style="width:48px">MIN</span><span>SEK</span></div>
              </div>
            </div>
          </div>
        </div>

        <div style="position:relative; height:44px; background:#FECB0F; display:flex; align-items:center; overflow:hidden; flex:none">
          <div style="display:flex; white-space:nowrap; font:600 12px 'IBM Plex Mono',monospace; color:#070707; letter-spacing:.16em; animation:marquee 28s linear infinite">
            {/* Traka se ispisuje dva puta, jer animacija pomera pola sirine. */}
            {[0, 1].map(() => hero.traka.map((t, i) => (
              <span style="padding-right:44px">{i === 0 ? t : `/ ${t}`}</span>
            )))}
          </div>
        </div>
      </section>

      <section style="position:relative; z-index:2; background:#0b0b0b; border-top:1px solid rgba(255,255,255,.08); box-shadow:0 -30px 60px rgba(0,0,0,.55)">
        <div style="max-width:1360px; margin:0 auto; padding:36px 32px; display:grid; grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr)); gap:0">
          {brojke.map((b, i) => (
            <div style={i === 0 ? 'padding:0 28px 0 0' : `padding:${i === brojke.length - 1 ? '0 0 0 28px' : '0 28px'}; border-left:1px solid rgba(255,255,255,.1)`}><div style="font:700 42px 'IBM Plex Sans',system-ui,sans-serif; color:#FECB0F; letter-spacing:-.03em">{b.broj}</div><div style="font:400 13.5px/1.5 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.6); margin-top:8px">{b.tekst}</div></div>
          ))}
        </div>
      </section>

      <section id="provera" style="position:relative; z-index:2; background:#070707; border-top:1px solid rgba(255,255,255,.08); padding:96px 32px 100px">
        <div style="max-width:1360px; margin:0 auto; display:flex; flex-wrap:wrap; gap:60px">
          <div style="flex:1 1 480px; min-width:0" data-rv>
            <p style="margin:0 0 14px; font:500 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(254,203,15,.7)">{provera.oznaka}</p>
            <h2 style="margin:0 0 12px; font:700 clamp(30px,3.2vw,44px)/1.04 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em; color:#fff">{provera.naslov}</h2>
            <p style="margin:0 0 36px; font:400 16.5px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.62)">{provera.uvod}</p>
            <p style="margin:0 0 12px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.16em; color:rgba(255,255,255,.45)">{provera.pitanje1}</p>
            <div style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:26px">
              {empOpts.map((t, i) => (
                <button type="button" class="opt" data-q="emp" data-i={i} aria-pressed={i === empDefault ? 'true' : 'false'}>{t}</button>
              ))}
            </div>
            <p style="margin:0 0 12px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.16em; color:rgba(255,255,255,.45)">{provera.pitanje2}</p>
            <div style="display:flex; flex-wrap:wrap; gap:10px">
              {actOpts.map((t, i) => (
                <button type="button" class="opt" data-q="act" data-i={i} aria-pressed={i === actDefault ? 'true' : 'false'} style="text-align:left">{t}</button>
              ))}
            </div>
            <p style="margin:32px 0 0; font:400 13px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.4); max-width:58ch">{provera.napomena}</p>
          </div>
          <div aria-live="polite" style="flex:1 1 420px; min-width:0; background:#FECB0F; color:#070707; padding:34px 34px 30px; min-height:360px; align-self:stretch; display:flex; flex-direction:column; gap:16px" data-rv>
            <p style="margin:0; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(7,7,7,.55)">{provera.rezultatOznaka}</p>
            <p id="res-title" style="margin:0; font:700 clamp(28px,2.8vw,40px)/1.04 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.025em">{initial.title}</p>
            <p id="res-body" style="margin:0; font:400 15.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.85)">{initial.body}</p>
            <div id="res-fine" hidden={!initial.fine} style="display:flex; flex-wrap:wrap; gap:30px; border-top:1.5px solid rgba(7,7,7,.3); padding-top:16px">
              <div><p style="margin:0; font:600 10px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(7,7,7,.5)">{provera.rokOznaka}</p><p style="margin:4px 0 0; font:700 19px 'IBM Plex Sans',system-ui,sans-serif">{provera.rok}</p></div>
              <div><p style="margin:0; font:600 10px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(7,7,7,.5)">{provera.kaznaOznaka}</p><p style="margin:4px 0 0; font:700 19px 'IBM Plex Sans',system-ui,sans-serif">{provera.kazna}</p></div>
            </div>
            <div style="margin-top:auto"><a href="#kontakt" class="btn-dark" style="display:inline-block; background:#070707; color:#FECB0F; font:700 14px 'IBM Plex Sans',system-ui,sans-serif; padding:14px 24px">{provera.dugme}</a></div>
          </div>
        </div>
      </section>

      <section id="usluge" style="position:relative; z-index:2; background:#EFEDE6; color:#070707; padding:96px 32px 100px">
        <div style="max-width:1360px; margin:0 auto">
          <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:44px" data-rv>
            <h2 style="margin:0; font:700 clamp(32px,3.6vw,48px) 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.035em">{uslugeTekst.naslov}</h2>
            <span style="font:500 11px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.45); letter-spacing:.2em">{uslugeTekst.oznaka}</span>
          </div>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr)); gap:24px">
            {services.map((s) => (
              <a
                href={`/usluge#${s.id}`}
                class="keep-ink"
                data-rv
                style={
                  s.featured
                    ? 'display:block; border-top:3px solid #FECB0F; padding:20px 0 8px; color:#070707; background:linear-gradient(180deg,rgba(254,203,15,.22),transparent 65%)'
                    : 'display:block; border-top:3px solid #070707; padding:20px 0 8px; color:#070707'
                }
              >
                <div style="font:500 11px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.4); letter-spacing:.16em">{s.num}</div>
                <h3 style="margin:12px 0 10px; font:700 20px/1.2 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.01em">{s.title}</h3>
                <p style="margin:0; font:400 14.5px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65)">{s.text}</p>
                <div style="margin-top:16px; font:600 13px 'IBM Plex Mono',monospace">{uslugeTekst.vise}</div>
              </a>
            ))}
          </div>

          <div style="border-top:1px solid rgba(7,7,7,.15); margin-top:72px; padding-top:56px; display:flex; flex-wrap:wrap; gap:56px" id="kako">
            <div style="flex:0 1 340px" data-rv>
              <p style="margin:0 0 12px; font:500 11px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.45); letter-spacing:.2em">{kako.oznaka}</p>
              <h2 style="margin:0; font:700 clamp(28px,3vw,40px)/1.05 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em">{kako.naslov}</h2>
              <p style="margin:16px 0 0; font:400 15.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65)">{kako.uvod}</p>
            </div>
            <div style="flex:1 1 560px; min-width:0">
              {kako.koraci.map((k) => (
                <div style={k.highlight ? 'display:flex; gap:24px; border-top:1px solid rgba(7,7,7,.18); border-bottom:1px solid rgba(7,7,7,.18); padding:22px 0' : 'display:flex; gap:24px; border-top:1px solid rgba(7,7,7,.18); padding:22px 0'} data-rv>
                  <span style={k.highlight ? "font:700 34px 'IBM Plex Mono',monospace; color:#FECB0F; -webkit-text-stroke:1px #070707; flex:none; width:64px" : "font:700 34px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.2); flex:none; width:64px"}>{k.n}</span>
                  <div><h3 style="margin:0 0 6px; font:700 18px 'IBM Plex Sans',system-ui,sans-serif">{k.naslov}</h3><p style="margin:0; font:400 14.5px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65)">{k.tekst}</p></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="rokovi" style="z-index:2; background:#070707; border-top:3px solid #FECB0F; padding:96px 32px 100px; position:relative; overflow:hidden">
        <div style="position:absolute; inset:0; background-image:linear-gradient(rgba(254,203,15,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(254,203,15,.04) 1px,transparent 1px); background-size:56px 56px; pointer-events:none"></div>
        <div style="max-width:1360px; margin:0 auto; position:relative">
          <p style="margin:0 0 14px; font:500 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(254,203,15,.7)" data-rv>{rokovi.oznaka}</p>
          <div style="display:flex; flex-wrap:wrap; align-items:flex-end; gap:40px 80px" data-rv>
            <h2 style="margin:0; font:700 clamp(52px,7vw,110px)/0.95 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.04em; color:#FECB0F">{rokovi.datumRed1}<br />{rokovi.datumRed2}</h2>
            <div style="padding-bottom:8px">
              <div style="font:700 clamp(34px,4vw,56px) 'IBM Plex Mono',monospace; color:#fff; letter-spacing:.02em; font-variant-numeric:tabular-nums"><span data-cd="days">{cd.days}</span><span style="color:rgba(255,255,255,.3)">:</span><span data-cd="hh">{cd.hh}</span><span style="color:rgba(255,255,255,.3)">:</span><span data-cd="mm">{cd.mm}</span><span style="color:rgba(255,255,255,.3)">:</span><span data-cd="ss">{cd.ss}</span></div>
              <div style="font:500 10.5px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.45); letter-spacing:.3em; margin-top:6px">DANA · SATI · MINUTA · SEKUNDI</div>
            </div>
          </div>
          <p style="margin:30px 0 0; font:400 17px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.72); max-width:66ch" data-rv>{rokovi.tekst}</p>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr)); gap:24px; margin-top:44px">
            {rokovi.kazne.map((k) => (
              <div style="border:1px solid rgba(255,255,255,.14); padding:22px" data-rv>
                <p style="margin:0; font:600 10px 'IBM Plex Mono',monospace; letter-spacing:.18em; color:rgba(255,255,255,.45)">{k.oznaka}</p>
                <p style="margin:10px 0 0; font:700 28px 'IBM Plex Sans',system-ui,sans-serif; color:#FECB0F; letter-spacing:-.02em">{k.iznos} <span style="font:500 13px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.5)">{k.valuta}</span></p>
              </div>
            ))}
          </div>
          <div style="border-left:3px solid #FECB0F; padding:4px 0 4px 22px; margin-top:36px" data-rv>
            <p style="margin:0; font:400 15.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.75); max-width:70ch"><strong style="color:#fff">{rokovi.gradilistaJako}</strong>{rokovi.gradilistaTekst}</p>
            <p style="margin:10px 0 0; font:400 13px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.38)">{rokovi.izvor}</p>
          </div>
        </div>
      </section>

      <section id="paketi" style="position:relative; z-index:2; background:#EFEDE6; color:#070707; padding:96px 32px 88px">
        <div style="max-width:1360px; margin:0 auto">
          <div style="max-width:640px; margin-bottom:44px" data-rv>
            <p style="margin:0 0 12px; font:500 11px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.45); letter-spacing:.2em">{paketi.oznaka}</p>
            <h2 style="margin:0 0 14px; font:700 clamp(32px,3.6vw,48px)/1.05 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.035em">{paketi.naslov}</h2>
            <p style="margin:0; font:400 16.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65)">{paketi.uvod}</p>
          </div>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr)); gap:28px; align-items:stretch">
            {prices.packages.map((p) => (
              <div
                data-rv
                style={
                  p.featured
                    ? 'background:#FECB0F; border:3px solid #070707; padding:32px 32px 28px; display:flex; flex-direction:column; position:relative'
                    : 'background:#fff; border:1px solid rgba(7,7,7,.18); padding:32px 32px 28px; display:flex; flex-direction:column'
                }
              >
                {p.badge && (
                  <span style="position:absolute; top:-14px; right:24px; background:#070707; color:#FECB0F; font:700 10.5px 'IBM Plex Mono',monospace; letter-spacing:.16em; padding:6px 12px">{p.badge}</span>
                )}
                <p style="margin:0; font:700 18px 'IBM Plex Sans',system-ui,sans-serif">{cena(p.ref).naziv}</p>
                <p style="margin:8px 0 20px; font:700 34px 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.02em">{`${cena(p.ref).iznos} ${p.suffix}`.trim()} <span style="font:500 13px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.5)">{p.unit}</span></p>
                <div style={`display:grid; gap:12px; font:400 15px/1.5 "IBM Plex Sans",system-ui,sans-serif; color:rgba(7,7,7,${p.featured ? '.85' : '.8'})`}>
                  {p.features.map((f) => (
                    <div style="display:flex; gap:10px"><span style={p.featured ? 'font-weight:700' : 'color:#070707; font-weight:700'}>+</span>{f}</div>
                  ))}
                </div>
                <a
                  href="#kontakt"
                  class={p.featured ? 'btn-dark' : 'btn-outline'}
                  style={
                    p.featured
                      ? 'margin-top:auto; display:inline-block; background:#070707; color:#FECB0F; font:700 14px "IBM Plex Sans",system-ui,sans-serif; padding:15px 22px; text-align:center; margin-top:28px'
                      : 'margin-top:auto; display:inline-block; border:2px solid #070707; color:#070707; font:700 14px "IBM Plex Sans",system-ui,sans-serif; padding:13px 22px; text-align:center; margin-top:28px'
                  }
                >{p.cta}</a>
              </div>
            ))}
          </div>
          <p style="margin:20px 0 0; font:400 13.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.5)" data-rv>{prices.packagesNote}</p>

          <div id="cenovnik" style="border-top:1px solid rgba(7,7,7,.15); margin-top:64px; padding-top:56px; display:flex; flex-wrap:wrap; gap:56px">
            <div style="flex:0 1 340px" data-rv>
              <p style="margin:0 0 12px; font:500 11px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.45); letter-spacing:.2em">{cenovnikTekst.oznaka}</p>
              <h2 style="margin:0 0 14px; font:700 clamp(28px,3vw,40px)/1.05 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em">{cenovnikTekst.naslov}</h2>
              <p style="margin:0; font:400 15.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65)">{cenovnikTekst.uvod}</p>
              <a href="/cenovnik" class="keep-ink" style="display:inline-block; margin-top:22px; font:700 13px 'IBM Plex Mono',monospace; color:#070707; border-bottom:2px solid #070707; padding-bottom:3px">{cenovnikTekst.link}</a>
            </div>
            <div style="flex:1 1 520px; min-width:0; font:400 15.5px 'IBM Plex Sans',system-ui,sans-serif" data-rv>
              {prices.items.map((it) => (
                <div style="display:flex; justify-content:space-between; gap:24px; border-bottom:1px solid rgba(7,7,7,.2); padding:14px 0"><span>{labelReda(it)}</span><strong style={it.tabular ? 'font-variant-numeric:tabular-nums; white-space:nowrap' : 'white-space:nowrap'}>{cena(it.ref).iznos}</strong></div>
              ))}
              <p style="margin:12px 0 0; font:400 13px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.45)">{prices.itemsNote}</p>
            </div>
          </div>
        </div>
      </section>

      <section id="zasto" style="position:relative; z-index:2; background:#070707; border-top:1px solid rgba(255,255,255,.08); padding:96px 32px 100px">
        <div style="max-width:1360px; margin:0 auto">
          <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:44px" data-rv>
            <h2 style="margin:0; font:700 clamp(32px,3.6vw,48px) 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.035em; color:#fff">{zasto.naslov}</h2>
            <span style="font:500 11px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.4); letter-spacing:.2em">{zasto.oznaka}</span>
          </div>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(230px,100%),1fr)); gap:16px" data-rv>
            {zasto.licence.map((l) => (
              <div style="border:1px solid rgba(254,203,15,.3); padding:20px"><p style="margin:0; font:600 10px 'IBM Plex Mono',monospace; letter-spacing:.16em; color:rgba(254,203,15,.7)">{l.oznaka}</p><p style="margin:10px 0 0; font:700 15.5px/1.35 'IBM Plex Sans',system-ui,sans-serif; color:#fff">{l.tekst}</p></div>
            ))}
          </div>
          <p style="margin:14px 0 0; font:400 13px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.4)" data-rv>{zasto.licenceNapomena}</p>

          <div style="margin-top:56px" data-rv>
            <p style="margin:0 0 18px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.2em; color:rgba(255,255,255,.45)">{zasto.iskustvoOznaka}</p>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr)); gap:0; border-top:1px solid rgba(255,255,255,.14)">
              {zasto.rafinerije.map((r, i) => (
                <div style={`border-bottom:1px solid rgba(255,255,255,.14); padding:${i === 0 ? '18px 20px 18px 0' : i === zasto.rafinerije.length - 1 ? '18px 0 18px 20px' : '18px 20px'}`}><p style="margin:0; font:700 19px 'IBM Plex Sans',system-ui,sans-serif; color:#fff">{r.ime}</p><p style="margin:4px 0 0; font:500 11.5px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.45)">{r.mesto}</p></div>
              ))}
            </div>
            <p style="margin:18px 0 0; font:400 15.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.65); max-width:64ch">{zasto.iskustvoTekst}</p>
          </div>

          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr)); gap:24px; margin-top:48px">
            {zasto.kartice.map((k) => (
              <div style="background:#0d0d0d; border:1px solid rgba(255,255,255,.1); padding:24px" data-rv>
                <p style="margin:0 0 10px; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.18em; color:#FECB0F">{k.oznaka}</p>
                <p style="margin:0; font:400 15px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.72)">{k.tekst}</p>
              </div>
            ))}
            <div style="background:#0d0d0d; border:1px solid rgba(255,255,255,.1); padding:24px" data-rv>
              <p style="margin:0 0 10px; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.18em; color:#FECB0F">{zasto.gde.oznaka}</p>
              <p style="margin:0; font:400 15px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.72)">{zasto.gde.delovi.map((d) => (<Fragment><strong style="color:#fff">{d.jako}</strong>{d.tekst}</Fragment>))}</p>
            </div>
          </div>
          <p style="margin:28px 0 0; font:400 13.5px/1.65 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.4); max-width:78ch" data-rv>{zasto.napomena}</p>
        </div>
      </section>

      <section id="faq" data-parallax="faq" style="position:relative; z-index:1; will-change:transform; background:#EFEDE6; color:#070707; padding:96px 32px 100px">
        <div style="max-width:1360px; margin:0 auto; display:flex; flex-wrap:wrap; gap:56px">
          <div style="flex:0 1 340px" data-rv>
            <p style="margin:0 0 12px; font:500 11px 'IBM Plex Mono',monospace; color:rgba(7,7,7,.45); letter-spacing:.2em">{faqTekst.oznaka}</p>
            <h2 style="margin:0; font:700 clamp(28px,3vw,40px)/1.05 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.03em">{faqTekst.naslov}</h2>
            <p style="margin:16px 0 0; font:400 15.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.65)">{faqTekst.uvod}</p>
          </div>
          <div style="flex:1 1 620px; min-width:0" data-rv>
            {faq.map((item, i) => (
              <details
                open={item.open}
                style={
                  i === faq.length - 1
                    ? 'border-top:1px solid rgba(7,7,7,.2); border-bottom:1px solid rgba(7,7,7,.2)'
                    : 'border-top:1px solid rgba(7,7,7,.2)'
                }
              >
                <summary style="display:flex; justify-content:space-between; align-items:center; gap:20px; padding:20px 0; font:700 17px 'IBM Plex Sans',system-ui,sans-serif">{item.q}<span class="faq-x" style="font:400 26px 'IBM Plex Sans',system-ui,sans-serif; flex:none">+</span></summary>
                <p style="margin:0; padding:0 44px 22px 0; font:400 15px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(7,7,7,.7)">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="kontakt" data-parallax="pre" data-pull style="position:relative; z-index:2; will-change:transform; background:#070707; border-top:3px solid #FECB0F; padding:96px 32px 136px; box-shadow:0 -40px 80px rgba(0,0,0,.55)">
        <div style="max-width:1360px; margin:0 auto; display:flex; flex-wrap:wrap; gap:60px">
          <div style="flex:0 1 400px" data-rv>
            <p style="margin:0 0 12px; font:500 11px 'IBM Plex Mono',monospace; letter-spacing:.22em; color:rgba(254,203,15,.7)">{kontakt.oznaka}</p>
            <h2 style="margin:0 0 16px; font:700 clamp(32px,3.6vw,48px)/1.04 'IBM Plex Sans',system-ui,sans-serif; letter-spacing:-.035em; color:#fff">{kontakt.naslov}</h2>
            <p style="margin:0 0 28px; font:400 16px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.65)">{kontakt.uvod}</p>
            <div style="display:grid; gap:14px; font:500 14px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.8)">
              <a href={firma.telefonHref} style="color:#FECB0F">{firma.telefon}</a>
              <a href={`mailto:${firma.imejl}`} style="color:rgba(255,255,255,.8)">{firma.imejl}</a>
              <span style="color:rgba(255,255,255,.5)">{firma.adresa}<br />{firma.grad}</span>
              <span style="color:rgba(255,255,255,.5)">{firma.radnoVreme}</span>
            </div>
          </div>
          <div style="flex:1 1 560px; min-width:0" data-rv>
            <div id="pp-form">
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr)); gap:18px">
                <label style="display:grid; gap:7px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(255,255,255,.55)">{kontakt.polja.ime}
                  <input type="text" autocomplete="name" class="field" style="background:#0e0e0e; border:1px solid rgba(255,255,255,.2); color:#fff; font-size:15px; padding:14px 14px; outline:none; min-height:20px" />
                </label>
                <label style="display:grid; gap:7px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(255,255,255,.55)">{kontakt.polja.firma}
                  <input type="text" autocomplete="organization" class="field" style="background:#0e0e0e; border:1px solid rgba(255,255,255,.2); color:#fff; font-size:15px; padding:14px 14px; outline:none" />
                </label>
                <label style="display:grid; gap:7px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(255,255,255,.55)">{kontakt.polja.kontakt}
                  <input type="text" inputmode="email" class="field" style="background:#0e0e0e; border:1px solid rgba(255,255,255,.2); color:#fff; font-size:15px; padding:14px 14px; outline:none" />
                </label>
                <label style="display:grid; gap:7px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(255,255,255,.55)">{kontakt.polja.zaposleni}
                  <select class="field" style="background:#0e0e0e; border:1px solid rgba(255,255,255,.2); color:#fff; font-size:15px; padding:14px 10px; outline:none">
                    {formOptions.zaposleni.map((o) => (<option>{o}</option>))}
                  </select>
                </label>
                <label style="display:grid; gap:7px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(255,255,255,.55); grid-column:1/-1">{kontakt.polja.delatnost}
                  <select class="field" style="background:#0e0e0e; border:1px solid rgba(255,255,255,.2); color:#fff; font-size:15px; padding:14px 10px; outline:none">
                    {formOptions.delatnost.map((o) => (<option>{o}</option>))}
                  </select>
                </label>
                <label style="display:grid; gap:7px; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(255,255,255,.55); grid-column:1/-1">{kontakt.polja.poruka}
                  <textarea rows="3" class="field" style="background:#0e0e0e; border:1px solid rgba(255,255,255,.2); color:#fff; font-size:15px; padding:14px 14px; outline:none; resize:vertical"></textarea>
                </label>
              </div>
              <label style="display:flex; gap:12px; align-items:flex-start; margin-top:20px; font:400 13.5px/1.55 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.6); cursor:pointer">
                <input type="checkbox" id="pp-consent" style="width:18px; height:18px; margin-top:2px; accent-color:#FECB0F; flex:none" />
                <span>{kontakt.saglasnost}</span>
              </label>
              <p id="pp-need-consent" hidden style="margin:12px 0 0; font:500 13px 'IBM Plex Mono',monospace; color:#FECB0F">{kontakt.saglasnostGreska}</p>
              <button type="button" id="pp-submit" class="btn-y" style="margin-top:24px; background:#FECB0F; color:#070707; border:none; font:700 15px 'IBM Plex Sans',system-ui,sans-serif; padding:16px 34px; cursor:pointer">{kontakt.dugme}</button>
            </div>
            <div id="pp-sent" hidden style="border:1px solid rgba(254,203,15,.4); padding:40px; text-align:left">
              <p style="margin:0; font:600 11px 'IBM Plex Mono',monospace; letter-spacing:.2em; color:#FECB0F">{kontakt.poslato.oznaka}</p>
              <p style="margin:14px 0 10px; font:700 28px 'IBM Plex Sans',system-ui,sans-serif; color:#fff; letter-spacing:-.02em">{kontakt.poslato.naslov}</p>
              <p style="margin:0; font:400 15.5px/1.6 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.7)">{kontakt.poslato.tekstPre}<a href={firma.telefonHref} style="color:#FECB0F; text-decoration:underline; text-underline-offset:3px">{firma.telefon}</a>{kontakt.poslato.tekstPosle}</p>
            </div>
          </div>
        </div>
      </section>

      <Footer />
    </div>

    <script type="application/json" id="pp-results" set:html={JSON.stringify(results)} is:inline></script>
    <script type="module" src="/refinery-scene.js" is:inline></script>

    <script>
      type Result = { title: string; body: string; fine: boolean };
      type Results = Record<'noEmp' | 'many' | 'risk' | 'office' | 'other', Result>;

      const results: Results = JSON.parse(
        document.getElementById('pp-results')?.textContent || '{}'
      );

      // Odbrojavanje do 1. januara 2027.
      const target = Date.parse('2027-01-01T00:00:00+01:00');
      const pad = (n: number) => String(n).padStart(2, '0');
      const slots: Record<string, NodeListOf<HTMLElement>> = {
        days: document.querySelectorAll('[data-cd="days"]'),
        hh: document.querySelectorAll('[data-cd="hh"]'),
        mm: document.querySelectorAll('[data-cd="mm"]'),
        ss: document.querySelectorAll('[data-cd="ss"]'),
      };
      const put = (key: string, value: string) => {
        slots[key].forEach((el) => {
          if (el.textContent !== value) el.textContent = value;
        });
      };
      const tick = () => {
        const d = Math.max(0, target - Date.now());
        put('days', String(Math.floor(d / 864e5)));
        put('hh', pad(Math.floor(d / 36e5) % 24));
        put('mm', pad(Math.floor(d / 6e4) % 60));
        put('ss', pad(Math.floor(d / 1e3) % 60));
      };
      tick();
      setInterval(tick, 1000);

      // Prebacivanje pisma vodi Header.astro, jer traka postoji na svim stranama.

      // Provera obaveza.
      const state = { emp: 1, act: 0 };
      const resTitle = document.getElementById('res-title');
      const resBody = document.getElementById('res-body');
      const resFine = document.getElementById('res-fine');
      const opts = document.querySelectorAll<HTMLButtonElement>('.opt');

      const pick = (): Result => {
        if (state.emp === 0) return results.noEmp;
        if (state.emp === 2) return results.many;
        if (state.act === 0) return results.risk;
        if (state.act === 1) return results.office;
        return results.other;
      };
      const renderResult = () => {
        const r = pick();
        if (resTitle) resTitle.textContent = r.title;
        if (resBody) resBody.textContent = r.body;
        if (resFine) resFine.hidden = !r.fine;
      };
      opts.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.q as 'emp' | 'act';
          const i = Number(btn.dataset.i);
          state[key] = i;
          opts.forEach((b) => {
            if (b.dataset.q === key) b.setAttribute('aria-pressed', String(Number(b.dataset.i) === i));
          });
          renderResult();
        });
      });

      // Kontakt forma.
      const consent = document.getElementById('pp-consent') as HTMLInputElement | null;
      const needConsent = document.getElementById('pp-need-consent');
      const formBox = document.getElementById('pp-form');
      const sentBox = document.getElementById('pp-sent');
      consent?.addEventListener('change', () => {
        if (needConsent) needConsent.hidden = true;
      });
      document.getElementById('pp-submit')?.addEventListener('click', () => {
        if (consent?.checked) {
          if (formBox) formBox.hidden = true;
          if (sentBox) sentBox.hidden = false;
        } else if (needConsent) {
          needConsent.hidden = false;
        }
      });

      // Otkrivanje pri skrolovanju.
      const revealed = document.querySelectorAll<HTMLElement>('[data-rv]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('rv-on');
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12 }
        );
        revealed.forEach((el) => io.observe(el));
      } else {
        revealed.forEach((el) => el.classList.add('rv-on'));
      }

      // Paralaksa hero i FAQ sekcije vodi Footer.astro, jer je zajednicka.
    </script>
  </body>
</html>
